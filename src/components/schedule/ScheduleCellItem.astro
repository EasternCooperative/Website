---
import type { CollectionEntry } from 'astro:content';
import PersonPhoto from '~/components/ui/PersonPhoto.astro';
import type { GridCellItem } from './scheduleGrid';
import type { EventClass } from '~/utils/classes';

interface Props {
  item: GridCellItem;
  classes: EventClass[];
  leaderMap: Map<string, CollectionEntry<'leader'>['data']>;
  peopleFlag: boolean;
}

const { item, classes, leaderMap, peopleFlag } = Astro.props;

const cls = item.classIndex != null ? classes[item.classIndex] : undefined;
const hasPopover = !!(cls && (cls.description || cls.callout));

type ResolvedLeader = { id?: string; name: string; photo?: string; hasBio: boolean };

function resolveLeaders(c?: EventClass): ResolvedLeader[] {
  if (!c) return [];
  const entries = c.leaders?.length ? c.leaders : c.leaderId || c.leader ? [{ id: c.leaderId, name: c.leader }] : [];
  return entries.flatMap((e): ResolvedLeader[] => {
    const rec = e.id ? leaderMap.get(e.id) : undefined;
    const name = rec?.name ?? e.name;
    if (!name) return [];
    return [{ id: e.id, name, photo: rec?.photo, hasBio: peopleFlag || !!rec?.bio }];
  });
}

const leaders = resolveLeaders(cls);
---

{
  hasPopover ? (
    <button
      type="button"
      data-popover-target={`sd-${item.classIndex}`}
      aria-controls={`sd-${item.classIndex}`}
      aria-expanded="false"
      class="sched-trigger cursor-pointer text-left font-semibold text-heading underline decoration-dotted underline-offset-2 transition-colors hover:text-primary"
    >
      {item.name}
    </button>
  ) : (
    <span class="font-semibold text-heading">{item.name}</span>
  )
}
{
  leaders.length > 0 && (
    <span class="mt-0.5 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs text-muted italic">
      {leaders.map((l, i) => (
        <span class="not-italic inline-flex items-center gap-1">
          {l.photo && <PersonPhoto name={l.name} photo={l.photo} size={16} />}
          {l.id && l.hasBio ? (
            <button
              type="button"
              data-popover-target={`leader-${l.id}`}
              aria-controls={`leader-${l.id}`}
              aria-expanded="false"
              class="sched-trigger cursor-pointer italic underline decoration-dotted underline-offset-2 transition-colors hover:text-primary"
            >
              {l.name}
            </button>
          ) : (
            <span class="italic">{l.name}</span>
          )}
          {i < leaders.length - 1 && <span class="not-italic">,</span>}
        </span>
      ))}
    </span>
  )
}
