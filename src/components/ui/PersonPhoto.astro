---
import Image from '~/components/common/Image.astro';

interface Props {
  name: string;
  photo: string;
  size: number;
  class?: string;
}

const { name, photo, size, class: className } = Astro.props;
const dialogId = `person-photo-${crypto.randomUUID()}`;
---

<button
  type="button"
  data-photo-trigger
  data-dialog-id={dialogId}
  aria-label={`View larger photo of ${name}`}
  class:list={['rounded-full flex-shrink-0 cursor-pointer p-0 border-0 overflow-hidden', className]}
  style={`width:${size}px;height:${size}px`}
>
  <Image
    src={photo}
    alt={name}
    width={size}
    height={size}
    widths={[size, size * 2]}
    sizes={`${size}px`}
    layout="cover"
    class="object-cover"
    style={`width:${size}px;height:${size}px`}
  />
</button>
<dialog
  id={dialogId}
  data-photo-dialog
  class="m-auto max-w-[min(90vw,24rem)] w-full rounded-2xl bg-transparent p-0 backdrop:bg-black/60"
>
  <div class="relative bg-page rounded-2xl p-4 shadow-xl">
    <button
      type="button"
      data-dialog-close
      aria-label="Close"
      class="absolute top-2 right-2 w-9 h-9 flex items-center justify-center rounded-full bg-page/90 text-heading hover:bg-primary/10 cursor-pointer border-0 text-xl leading-none"
    >
      ×
    </button>
    <Image
      src={photo}
      alt={name}
      width={400}
      height={400}
      widths={[400, 800]}
      sizes="400px"
      layout="cover"
      class="w-full aspect-square rounded-xl object-cover"
    />
    <p class="mt-3 text-center font-semibold text-heading">{name}</p>
  </div>
</dialog>

<style>
  :global(.person-photo-preview) {
    /* Overrides the UA popover defaults (inset: 0; margin: auto) so the
       inline left/top set by positionPreview() are the only things placing
       this element — otherwise the leftover auto-margins/inset fight the
       explicit position. */
    position: fixed;
    inset: auto;
    margin: 0;
    z-index: 60;
    width: 220px;
    height: 220px;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    background: var(--aw-color-bg-page, #fff);
    pointer-events: none;
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 0.12s ease,
      transform 0.12s ease;
  }
  :global(.person-photo-preview.is-visible) {
    opacity: 1;
    transform: scale(1);
  }
  :global(.person-photo-preview img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  :global(.person-photo-preview.is-loaded img) {
    opacity: 1;
  }

  dialog[data-photo-dialog] {
    animation: person-photo-dialog-in 0.15s ease-out;
  }
  @keyframes person-photo-dialog-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
