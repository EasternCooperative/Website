---
import ZoomablePhoto from '~/components/ui/ZoomablePhoto.astro';

interface Props {
  name: string;
  photo: string;
  size: number;
  class?: string;
}

const { name, photo, size, class: className } = Astro.props;
const px = `width:${size}px;height:${size}px`;
---

<ZoomablePhoto
  src={photo}
  alt={name}
  label={`View larger photo of ${name}`}
  caption={name}
  width={size}
  height={size}
  widths={[size, size * 2]}
  sizes={`${size}px`}
  class={['rounded-full flex-shrink-0', className].filter(Boolean).join(' ')}
  style={px}
  imgStyle={px}
  dialogWidth={400}
  dialogHeight={400}
/>
