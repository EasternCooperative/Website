---
import PersonPhoto from '~/components/ui/PersonPhoto.astro';

interface Props {
  name: string;
  title?: string;
  photo?: string;
  bio?: string;
}

const { name, title, photo, bio } = Astro.props;
---

<div class:list={['flex gap-4', !bio && 'flex-col items-center text-center']}>
  {
    photo ? (
      <PersonPhoto name={name} photo={photo} size={88} class={bio ? 'mt-1' : undefined} />
    ) : (
      <div
        class:list={[
          'w-[88px] h-[88px] rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0',
          bio && 'mt-1',
        ]}
        aria-hidden="true"
      >
        <span class="text-2xl font-bold text-primary/60">{name.charAt(0)}</span>
      </div>
    )
  }
  <div class="min-w-0">
    <p class="font-semibold text-lg text-heading leading-snug">{name}</p>
    {title && <p class="text-base text-muted mb-1">{title}</p>}
    {bio && <p class="text-base text-default mt-1 leading-relaxed md-links" set:html={bio} />}
  </div>
</div>

<script>
  import { initPersonPhotoLightbox } from '~/utils/personPhotoLightbox';
  initPersonPhotoLightbox();
</script>
