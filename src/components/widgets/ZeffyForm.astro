---
interface Props {
  formUrl: string;
  formName?: string;
  eventId?: string;
  id?: string;
}

const { formUrl, formName, eventId, id } = Astro.props;
---

<section id={id} class="zeffy-section">
  <div
    class="zeffy-container"
    data-zeffy-container
    data-zeffy-form-name={formName}
    data-zeffy-form-url={formUrl}
    data-zeffy-event-id={eventId}
  >
    <div data-zeffy-embed data-form-url={formUrl}></div>
    <div data-zeffy-embed-fallback style="display:none;">
      <div style="position:relative;overflow:hidden;height:450px;width:100%;padding-top:450px;">
        <iframe
          title="Form powered by Zeffy"
          style="position: absolute; border: 0; top:0; left:0; bottom:0; right:0; width:100%; height:100%"
          data-zeffy-embed-src={`https://www.zeffy.com${formUrl}`}
          allowtransparency="true"
          {...{ allowpaymentrequest: true }}></iframe>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // zeffy-embed.js posts window messages tagged with the embed's data-zeffy-id
  // as the visitor moves through the form; "thank-you-page-shown" fires once,
  // right after a successful submission/payment. Attached once (not
  // data-astro-rerun) and guarded so repeat navigations don't stack listeners
  // — it re-queries the live DOM on every message, so it keeps working across
  // client-side navigations without needing to re-attach.
  if (!window.__ecrsZeffyTrackerAttached) {
    window.__ecrsZeffyTrackerAttached = true;
    window.addEventListener('message', function (e) {
      if (e.origin !== 'https://www.zeffy.com') return;
      const data = e.data;
      if (!data || data.type !== 'zeffy-embed:thank-you-page-shown' || !data.embedId) return;
      const embed = document.querySelector('[data-zeffy-id="' + CSS.escape(data.embedId) + '"]');
      const container = embed && embed.closest('[data-zeffy-container]');
      const name = container && container.dataset.zeffyFormName;
      if (name && window.ecrsTrack) {
        window.ecrsTrack('form_submit_' + name, { form_name: name });
      }
    });
  }
</script>

<script is:inline data-astro-rerun>
  (function () {
    // zeffy-embed.js scans the DOM once on load for [data-zeffy-embed] nodes,
    // so on a client-side (view transition) navigation back to a page with a
    // form we need to re-inject a fresh script tag to get it to scan again.
    document.querySelectorAll('[data-zeffy-container]').forEach(function (container) {
      const embed = container.querySelector('[data-zeffy-embed]');
      if (embed) embed.innerHTML = '';

      const s = document.createElement('script');
      s.src = 'https://www.zeffy.com/embed/v2/zeffy-embed.js';
      s.onerror = function () {
        container.querySelectorAll('[data-zeffy-embed-fallback]').forEach(function (el) {
          el.style.display = 'block';
          el.querySelectorAll('iframe[data-zeffy-embed-src]').forEach(function (f) {
            f.src = f.getAttribute('data-zeffy-embed-src');
          });
        });
      };
      container.appendChild(s);
    });
  })();
</script>

<script is:inline data-astro-rerun>
  (function () {
    // Mid-funnel signal for Ads: fire `form_view_event` (→ Meta ViewContent,
    // GA form_view) once the embedded Zeffy form has actually been on screen.
    // Deduplicated per visitor per event so it counts an intent signal, not a
    // scroll count.
    //
    // Observe the CONTAINER, not the iframe: on the primary path
    // zeffy-embed.js injects the iframe asynchronously (it doesn't exist when
    // this runs), and on the fallback path the iframe starts inside a
    // display:none wrapper and would never intersect.
    //
    // data-astro-rerun: this IIFE re-runs after every view-transition nav, and
    // a fresh container exists by then — tear down the previous observer and
    // dwell timer first (mirrors the __ecrsCognitoPrefillTimer cleanup in
    // CognitoForm.astro).
    if (window.__ecrsZeffyViewObserver) {
      window.__ecrsZeffyViewObserver.disconnect();
      window.__ecrsZeffyViewObserver = null;
    }
    if (window.__ecrsZeffyViewTimer) {
      clearTimeout(window.__ecrsZeffyViewTimer);
      window.__ecrsZeffyViewTimer = null;
    }

    const DWELL_MS = 1000;

    function alreadySent(key) {
      try {
        return localStorage.getItem(key) === '1';
      } catch {
        return false;
      }
    }
    function markSent(key) {
      try {
        localStorage.setItem(key, '1');
      } catch {
        /* private mode — best effort */
      }
    }

    function send(container) {
      const key = 'ecrs-zeffy-view-' + (container.dataset.zeffyFormUrl || '');
      if (alreadySent(key)) return true;

      const name = container.dataset.zeffyFormName || 'event';
      const params = {
        form_name: name,
        form_url: container.dataset.zeffyFormUrl || '',
        event_id: container.dataset.zeffyEventId || '',
      };

      if (window.gtag || window.fbq) {
        if (window.ecrsTrack) window.ecrsTrack('form_view_event', params);
        markSent(key);
        return true;
      }

      // Observer fired before the visitor answered the consent banner, so no
      // destination is loaded yet and ecrsTrack would no-op silently. Stash the
      // event and flush it once consent is granted. setTimeout(…, 0) lets
      // MetaPixel's own consent listener define window.fbq first.
      window.__ecrsZeffyViewPending = params;
      window.addEventListener(
        'ecrs:consent-granted',
        function () {
          setTimeout(function () {
            const p = window.__ecrsZeffyViewPending;
            if (!p) return;
            if (alreadySent(key)) {
              window.__ecrsZeffyViewPending = null;
              return;
            }
            if (window.ecrsTrack) window.ecrsTrack('form_view_event', p);
            markSent(key);
            window.__ecrsZeffyViewPending = null;
          }, 0);
        },
        { once: true }
      );
      return false;
    }

    const container = document.querySelector('[data-zeffy-container]');
    if (!container || !('IntersectionObserver' in window)) return;

    if (alreadySent('ecrs-zeffy-view-' + (container.dataset.zeffyFormUrl || ''))) return;

    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            // Only count a real form view: require the embed (or fallback)
            // iframe to actually be in the container, not an empty box.
            if (!entry.target.querySelector('iframe')) return;
            if (window.__ecrsZeffyViewTimer) return;
            window.__ecrsZeffyViewTimer = setTimeout(function () {
              window.__ecrsZeffyViewTimer = null;
              if (send(entry.target)) observer.disconnect();
            }, DWELL_MS);
          } else if (window.__ecrsZeffyViewTimer) {
            clearTimeout(window.__ecrsZeffyViewTimer);
            window.__ecrsZeffyViewTimer = null;
          }
        });
      },
      { threshold: 0.5 }
    );
    observer.observe(container);
    window.__ecrsZeffyViewObserver = observer;
  })();
</script>

<style>
  .zeffy-section {
    padding: 3rem 1rem;
    background-color: var(--aw-color-bg-page);
  }
  .zeffy-container {
    max-width: 48rem;
    margin: 0 auto;
  }
</style>
