---
import { ANALYTICS } from 'astrowind:config';

interface Props {
  formId: string;
  formName?: string;
  id?: string;
  /** Hide the form's own title header, for pages that already have an h1. Off by default. */
  hideTitle?: boolean;
}

const { formId, formName, id, hideTitle = false } = Astro.props;
const COGNITO_KEY = 'tdXs_w0YA0KlSRyaghpLKw';
const hostedUrl = `https://www.cognitoforms.com/f/${COGNITO_KEY}/${formId}`;
// GA4 keeps the current session in a per-stream cookie: _ga_<id without "G-">.
const gaId = ANALYTICS?.vendors?.googleAnalytics?.id ? String(ANALYTICS.vendors.googleAnalytics.id) : '';
const gaSessionCookie = gaId ? `_ga_${gaId.replace(/^G-/, '')}` : undefined;
---

<section id={id} class="embed-form-section">
  <div
    class="embed-form-container"
    data-cognito-form={formId}
    data-cognito-form-name={formName}
    data-cognito-key={COGNITO_KEY}
    data-cognito-hide-title={hideTitle ? '' : undefined}
    data-ga-session-cookie={gaSessionCookie}
  ></div>
  <p class="embed-form-fallback">
    Form not loading?{' '}
    <a href={hostedUrl} target="_blank" rel="noopener noreferrer">
      Open it in a new tab
    </a>
  </p>
</section>

<script is:inline data-astro-rerun>
  (function () {
    // Tear down stale Cognito globals so seamless.js re-runs identically to a hard refresh.
    delete window.Cognito;
    delete window.Vue;
    delete window.cfWebpackJsonp;

    // For Ads attribution: the webhook (functions/api/track-purchase/cognito.js)
    // sends the payment to GA4 with this visitor's client_id (from _ga) and
    // session_id (from _ga_<stream>). Together they let GA4 join the purchase
    // to the session the ad click started, instead of "Unassigned". Requires
    // hidden "GAClientId" and "GASessionId" fields on the Cognito form.
    // Hidden "FBP" and "FBC" fields do the same job for Meta.
    function readCookie(name) {
      const m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]+)'));
      return m ? decodeURIComponent(m[1]) : '';
    }
    function getGaClientId() {
      const parts = readCookie('_ga').split('.');
      return parts.length >= 4 ? parts[2] + '.' + parts[3] : '';
    }
    // ga-session-parser:start
    // Older format: GS1.1.<session_id>.<session_number>.…
    // Newer format: GS2.1.s<session_id>$o<n>$g<n>$t<ts>…
    function parseGaSessionId(value) {
      if (!value) return '';
      if (value.indexOf('GS2.') === 0) {
        const fields = value.split('.').slice(2).join('.').split('$');
        for (let i = 0; i < fields.length; i++) {
          if (/^s\d+$/.test(fields[i])) return fields[i].slice(1);
        }
        return '';
      }
      if (value.indexOf('GS1.') === 0) {
        const id = value.split('.')[2] || '';
        return /^\d+$/.test(id) ? id : '';
      }
      return '';
    }
    // ga-session-parser:end

    document.querySelectorAll('[data-cognito-form]').forEach(function (container) {
      // data-astro-rerun means this whole IIFE re-runs on every client-side
      // nav. Each container tracks its own prefill timer and success
      // observer directly on the DOM node — not a shared window global —
      // so a page with more than one Cognito form doesn't have the second
      // form's handle clobber the first's, and a rerun tears down exactly
      // the handles it's about to replace rather than leaking them.
      if (container.__ecrsPrefillTimer) {
        clearInterval(container.__ecrsPrefillTimer);
        container.__ecrsPrefillTimer = null;
      }
      if (container.__ecrsSuccessObserver) {
        container.__ecrsSuccessObserver.disconnect();
        container.__ecrsSuccessObserver = null;
      }

      container.innerHTML = '';
      const s = document.createElement('script');
      s.src = 'https://www.cognitoforms.com/f/seamless.js';
      s.dataset.key = container.dataset.cognitoKey;
      s.dataset.form = container.dataset.cognitoForm;
      container.appendChild(s);

      // Hidden-field prefill, tried from most to least complete: a form that
      // lacks some of these fields may reject the unknown keys, so fall back
      // to the smaller sets rather than lose the GA ids it does have.
      const gaClientId = getGaClientId();
      const sessionCookie = container.dataset.gaSessionCookie;
      const gaSessionId = gaClientId && sessionCookie ? parseGaSessionId(readCookie(sessionCookie)) : '';
      // Meta browser id / click id, for the Conversions API purchase the
      // webhook sends (functions/_lib/meta.js). Present only when the pixel
      // has loaded, i.e. the visitor is allowed to be measured.
      const fbp = readCookie('_fbp');
      const fbc = readCookie('_fbc');

      const ga = {};
      if (gaClientId) ga.GAClientId = gaClientId;
      if (gaSessionId) ga.GASessionId = gaSessionId;
      const meta = {};
      if (fbp) meta.FBP = fbp;
      if (fbc) meta.FBC = fbc;

      const attempts = [Object.assign({}, ga, meta), ga, gaClientId ? { GAClientId: gaClientId } : {}].filter(
        function (data, i, all) {
          const key = JSON.stringify(data);
          return (
            key !== '{}' &&
            all.findIndex(function (d) {
              return JSON.stringify(d) === key;
            }) === i
          );
        }
      );

      if (attempts.length > 0) {
        let polls = 0;
        container.__ecrsPrefillTimer = setInterval(function () {
          polls++;
          if (window.Cognito && typeof window.Cognito.prefill === 'function') {
            clearInterval(container.__ecrsPrefillTimer);
            container.__ecrsPrefillTimer = null;
            for (let i = 0; i < attempts.length; i++) {
              try {
                window.Cognito.prefill(attempts[i]);
                break;
              } catch {
                /* this form has no matching hidden field for one of the keys: try the next, smaller set */
              }
            }
          } else if (polls > 40) {
            // ~4s: seamless.js likely failed to load, or Cognito.prefill
            // isn't available for this embed — stop polling.
            clearInterval(container.__ecrsPrefillTimer);
            container.__ecrsPrefillTimer = null;
          }
        }, 100);
      }

      const observer = new MutationObserver(function () {
        const form = container.querySelector('form.is-success');
        if (form) {
          observer.disconnect();
          container.__ecrsSuccessObserver = null;
          const name = container.dataset.cognitoFormName;
          if (name && window.ecrsTrack) {
            window.ecrsTrack('form_submit_' + name, { form_name: name, form_id: container.dataset.cognitoForm });
          }
        }
      });
      observer.observe(container, { subtree: true, attributes: true, attributeFilter: ['class'] });
      container.__ecrsSuccessObserver = observer;
    });
  })();
</script>
