---
// Classic Mailchimp form: POSTs directly to Mailchimp, no client-side JS or
// jQuery dependency (unlike mc-validate.js), so nothing here can reproduce
// the old jQuery-conflict mobile bug.
interface Props {
  id?: string;
}

const { id } = Astro.props;

// Tailwind's `gray`/`slate` scales read as blue against this site's warm
// dark background — see --aw-color-bg-surface-dark in custom-styles.css.
const surfaceBg = 'dark:bg-(--aw-color-bg-surface-dark)';
const surfaceBorder = 'dark:border-(--aw-color-border-surface-dark)';

// Sized and focus-styled to match Cognito's rendered fields on /contact
// (measured: 8px/10px padding, 16px type, 6px radius, a 2px 25%-opacity
// primary ring on focus rather than a solid Tailwind ring) — see the
// "Cognito Forms overrides" block in custom-styles.css for the same ring.
const focusRing = 'focus:shadow-[0_0_0_2px_rgb(from_var(--aw-color-primary)_r_g_b_/_25%)]';
const inputClass = `w-full rounded-md border border-gray-300 ${surfaceBorder} bg-white ${surfaceBg} px-2.5 py-2 text-base leading-[1.3] text-default focus:outline-none focus:border-primary ${focusRing}`;
const labelClass = 'block text-base font-bold text-default mb-1.5';
---

<form
  id={id}
  action="https://ecrs.us7.list-manage.com/subscribe/post?u=26c8c63440ac3a046e97a93c2&id=99254bd486&f_id=008609e4f0"
  method="post"
  name="mc-embedded-subscribe-form"
  target="_blank"
  class="max-w-md mx-auto space-y-4"
>
  <div>
    <label for="mce-EMAIL" class={labelClass}>
      {' '}
      Email <span class="text-red-600">*</span>{' '}
    </label>
    <input type="email" name="EMAIL" id="mce-EMAIL" autocomplete="email" required class={inputClass} />
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label for="mce-FNAME" class={labelClass}>
        First Name
      </label>
      <input type="text" name="FNAME" id="mce-FNAME" autocomplete="given-name" class={inputClass} />
    </div>
    <div>
      <label for="mce-LNAME" class={labelClass}>
        Last Name
      </label>
      <input type="text" name="LNAME" id="mce-LNAME" autocomplete="family-name" class={inputClass} />
    </div>
  </div>

  <div>
    <label for="mce-MMERGE4" class={labelClass}>
      Primary Phone
    </label>
    <input type="tel" name="MMERGE4" id="mce-MMERGE4" autocomplete="tel" class={inputClass} />
  </div>

  <fieldset class={`rounded-md border border-gray-200 ${surfaceBorder} p-4`}>
    <legend class="px-1 text-base font-bold text-default">
      Marketing Permissions <span class="text-red-600">*</span>
    </legend>
    <p class="mb-2 text-sm text-muted">
      Please select all the ways you would like to hear from Eastern Cooperative Recreation School:
    </p>
    <label class="flex w-fit cursor-pointer items-center gap-3 text-sm text-default">
      <span class="relative inline-flex shrink-0 items-center">
        <input type="checkbox" id="gdpr_6437" name="gdpr[6437]" value="Y" required class="peer sr-only" />
        <span
          class={`h-6 w-10 rounded-full bg-gray-300 dark:bg-(--aw-color-border-surface-dark) transition-colors peer-checked:bg-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primary peer-focus-visible:ring-offset-2`}
        ></span>
        <span class="absolute left-1 top-1 h-4 w-4 rounded-full bg-white transition-transform peer-checked:translate-x-4"></span>
      </span>
      Email
    </label>
    <p class="mt-2 text-xs text-muted">
      You can unsubscribe at any time by clicking the link in the footer of our emails. For information about our
      privacy practices, please visit our website.
    </p>
    <p class="mt-2 text-xs text-muted">
      We use Mailchimp as our marketing platform. By clicking below to subscribe, you acknowledge that your information
      will be transferred to Mailchimp for processing.{' '}
      <a href="https://mailchimp.com/legal/terms" class="underline" target="_blank" rel="noopener noreferrer">
        Learn more
      </a>{' '}
      about Mailchimp's privacy practices.
    </p>
  </fieldset>

  <div aria-hidden="true" class="absolute -left-[5000px]">
    <input type="text" name="b_26c8c63440ac3a046e97a93c2_99254bd486" tabindex="-1" value="" />
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <button type="submit" name="subscribe" class="btn-primary">
      Subscribe
    </button>
    <a href="http://eepurl.com/yaC1IN5Xzi" title="Mailchimp - email marketing made easy and fun">
      <img
        src="https://digitalasset.intuit.com/render/content/dam/intuit/mc-fe/en_us/images/intuit-mc-rewards-text-dark.svg"
        alt="Intuit Mailchimp"
        width="220"
        height="40"
        class="h-auto w-36 dark:hidden"
      />
      <img
        src="https://digitalasset.intuit.com/render/content/dam/intuit/mc-fe/en_us/images/intuit-mc-rewards-text-light.svg"
        alt="Intuit Mailchimp"
        width="220"
        height="40"
        class="hidden h-auto w-36 dark:block"
      />
    </a>
  </div>
</form>
