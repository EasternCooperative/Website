<script is:inline>
  window.ecrsTrack = function (eventName, params) {
    if (window.gtag) {
      window.gtag('event', eventName, params);
      // Google Ads only counts a conversion when it receives this dedicated
      // send_to tag — the generic event above lands in GA4 but Ads doesn't
      // treat it as a conversion on its own. Map event names to Ads
      // conversion labels (Google Ads > Goals > Conversions) here.
      //
      // No value is sent. What a registration is worth reaches Ads through the
      // GA4 `purchase` the payment webhooks send (functions/api/track-purchase),
      // so a value here would count that revenue a second time and feed
      // value-based bidding a made-up number.
      const adsConversionMap = {
        form_submit_event: 'AW-964636937/yRj5CMSu0PccEIni_MsD',
      };
      const adsLabel = adsConversionMap[eventName];
      if (adsLabel) {
        window.gtag('event', 'conversion', { send_to: adsLabel });
      }
    }
    if (window.fbq) {
      const metaMap = {
        form_submit_membership: 'Lead',
        form_submit_contact: 'Lead',
        form_submit_newsletter: 'Lead',
        form_submit_event: 'CompleteRegistration',
        form_submit_donation: 'Donate',
        form_view_event: 'ViewContent',
        // Opening the page of an event with no signup form is interest, not a
        // registration: reporting it as one teaches Meta to find page openers.
        event_view_conversion: 'ViewContent',
      };
      const metaEvent = metaMap[eventName];
      if (metaEvent) window.fbq('track', metaEvent, params);
    }
    // Future destinations: add an `if (window.newSdk)` block here.
  };

  // Plain HTML forms that post to a third party (the Mailchimp signup) have no
  // success callback to hook, so count the submit itself: the browser only
  // fires `submit` once its own validation has passed. Delegated on the
  // document so it survives View Transition swaps; this head script runs once.
  document.addEventListener('submit', function (e) {
    const form = e.target;
    const name = form && form.getAttribute && form.getAttribute('data-track-form');
    if (name) window.ecrsTrack('form_submit_' + name, { form_name: name });
  });
</script>
