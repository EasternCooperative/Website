---
// A small easter egg for anyone who opens devtools: the ECRS letters in the
// logo's four colors, plus a pointer to the source.
//
// The art is an array of rows (not one multi-line string) so neither Prettier
// nor the HTML/JS minifiers can disturb its spacing.
---

<script is:inline>
  (function () {
    // ClientRouter navigations can re-run inline scripts; greet once per load.
    if (window.__ecrsGreeted) return;
    window.__ecrsGreeted = true;

    const rows = [
      '███████╗ ██████╗██████╗ ███████╗',
      '██╔════╝██╔════╝██╔══██╗██╔════╝',
      '█████╗  ██║     ██████╔╝███████╗',
      '██╔══╝  ██║     ██╔══██╗╚════██║',
      '███████╗╚██████╗██║  ██║███████║',
      '╚══════╝ ╚═════╝╚═╝  ╚═╝╚══════╝',
    ];
    // One color per letter, taken from the four signs in the ECRS logo
    // (public/images/ecrs-logo.svg): pink E, blue C, green R, orange S.
    const colors = ['#eb018b', '#01aced', '#41b03b', '#f48612'];
    const art = 'font-family: monospace; line-height: 1.1; font-weight: bold; color: ';
    // Every letter is exactly this many characters wide in every row.
    const letterWidth = 8;

    let format = '';
    const styles = [];
    rows.forEach(function (row) {
      colors.forEach(function (color, i) {
        format += '%c' + row.slice(i * letterWidth, (i + 1) * letterWidth);
        styles.push(art + color);
      });
      format += '\n';
    });
    format += '%c\nEastern Cooperative Recreation School\n';
    styles.push('font-weight: bold');
    format += '%cCurious how this site is built? https://github.com/EasternCooperative/Website';
    styles.push('font-weight: normal');

    console.log(format, ...styles);
  })();
</script>
