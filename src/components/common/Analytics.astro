---
import { ANALYTICS } from 'astrowind:config';

const id = ANALYTICS?.vendors?.googleAnalytics?.id ? String(ANALYTICS.vendors.googleAnalytics.id) : '';
---

<script is:inline define:vars={{ GA_ID: id }}>
  (function () {
    if (!GA_ID) return;

    var STORAGE_KEY = 'ecrs-ga-consent';
    var loaded = false;

    function consentState(value) {
      return { ad_storage: value, ad_user_data: value, ad_personalization: value, analytics_storage: value };
    }
    var CONSENT_GRANTED = consentState('granted');
    var CONSENT_DENIED = consentState('denied');

    // Never load GA in local development.
    var host = location.hostname;
    var isLocal = host === 'localhost' || host === '127.0.0.1' || host === '';

    function getStored() {
      try {
        return localStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    }
    function setStored(v) {
      try {
        localStorage.setItem(STORAGE_KEY, v);
      } catch {
        /* localStorage may be unavailable (private mode) */
      }
    }

    function loadGA() {
      if (isLocal || loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      // Consent Mode v2. GA only ever loads once the visitor is allowed to be
      // measured (US, or an accepted banner), so the default is "granted";
      // stating it explicitly is what lets Google Ads use the data for
      // conversions and audiences. deny() below flips these if the visitor
      // later opts out in the same session.
      window.gtag('consent', 'default', CONSENT_GRANTED);
      window.gtag('js', new Date());
      // page_view is sent manually so it also fires on View Transition navigations.
      window.gtag('config', GA_ID, { send_page_view: false });
      sendPageView();
      scheduleAdsConversion();
    }

    // The Ads conversion config pulls in a heavy doubleclick/remarketing
    // request chain (confirmed via Lighthouse to dominate the critical path
    // and add seconds to LCP). Conversions are only ever fired later from a
    // real user action (e.g. a form submit in EventTracker.astro), so this
    // is tied to the visitor's first interaction rather than page load —
    // a fixed timer left it dangling as a visible "still loading" tab state
    // well after the page had already rendered. A long fallback timer still
    // covers visitors who never interact (e.g. pure view-through impressions).
    var adsConfigured = false;
    var INTERACTION_EVENTS = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
    function configureAdsConversion() {
      if (adsConfigured || !window.gtag) return;
      adsConfigured = true;
      INTERACTION_EVENTS.forEach(function (evt) {
        window.removeEventListener(evt, configureAdsConversion);
      });
      window.gtag('config', 'AW-964636937');
    }
    function scheduleAdsConversion() {
      INTERACTION_EVENTS.forEach(function (evt) {
        window.addEventListener(evt, configureAdsConversion, { passive: true });
      });
      var FALLBACK_DELAY_MS = 9000;
      if ('requestIdleCallback' in window) {
        requestIdleCallback(configureAdsConversion, { timeout: FALLBACK_DELAY_MS });
      } else {
        setTimeout(configureAdsConversion, FALLBACK_DELAY_MS);
      }
    }

    function sendPageView() {
      if (!loaded || !window.gtag) return;
      window.gtag('event', 'page_view', {
        page_location: location.href,
        page_path: location.pathname + location.search,
        page_title: document.title,
      });
    }

    // Consent region. Policy: the banner gates analytics everywhere except the
    // US. The country comes from Cloudflare's own /cdn-cgi/trace endpoint (a
    // tiny text response with a `loc=XX` line), asked for once per browser
    // session. It used to be stamped into the HTML by an edge function, which
    // meant every page request ran a Function and no HTML could be cached.
    // Unknown (lookup pending, failed, or blocked) is treated as gated: the
    // privacy-safe default.
    var REGION_KEY = 'ecrs-consent-region';
    var regionGated = null; // null until known
    try {
      var cachedRegion = sessionStorage.getItem(REGION_KEY);
      if (cachedRegion === 'open') regionGated = false;
      else if (cachedRegion === 'gated') regionGated = true;
    } catch {
      /* sessionStorage may be unavailable (private mode) */
    }

    function consentRequired() {
      return regionGated !== false;
    }

    var regionLookup = null;
    function resolveRegion() {
      if (regionGated !== null) return Promise.resolve();
      if (!regionLookup) {
        regionLookup = fetch('/cdn-cgi/trace', { cache: 'no-store' })
          .then(function (res) {
            return res.ok ? res.text() : '';
          })
          .then(function (text) {
            var match = /^loc=([A-Z]{2})\s*$/m.exec(text);
            regionGated = !(match && match[1] === 'US');
            // Only remember a real answer; a failed lookup is retried on the next full page load.
            if (match) {
              try {
                sessionStorage.setItem(REGION_KEY, regionGated ? 'gated' : 'open');
              } catch {
                /* best effort */
              }
            }
          })
          .catch(function () {
            regionGated = true;
          })
          .then(function () {
            regionLookup = null;
            window.dispatchEvent(new CustomEvent('ecrs:consent-region'));
          });
      }
      return regionLookup;
    }

    function banner() {
      return document.getElementById('consent-banner');
    }
    function showBanner() {
      var b = banner();
      if (b) b.hidden = false;
    }
    function hideBanner() {
      var b = banner();
      if (b) b.hidden = true;
    }

    function grant() {
      setStored('granted');
      window['ga-disable-' + GA_ID] = false;
      hideBanner();
      // Already loaded means the visitor declined earlier this session and is
      // now changing their mind: lift the denial recorded by deny().
      if (loaded && window.gtag) window.gtag('consent', 'update', CONSENT_GRANTED);
      loadGA();
      window.dispatchEvent(new CustomEvent('ecrs:consent-granted'));
    }
    function deny() {
      setStored('denied');
      // Stops GA immediately, even if it was already loaded this session.
      window['ga-disable-' + GA_ID] = true;
      if (loaded && window.gtag) window.gtag('consent', 'update', CONSENT_DENIED);
      hideBanner();
      window.dispatchEvent(new CustomEvent('ecrs:consent-denied'));
    }

    // Exposed for any external trigger (e.g. the footer "Cookie settings" link).
    // `required` is how MetaPixel.astro reads the region, so both scripts
    // always agree on it.
    window.__ecrsConsent = { grant: grant, deny: deny, show: showBanner, required: consentRequired };

    // Decide what to do on each page render.
    function apply() {
      var stored = getStored();
      if (regionGated === null) {
        // Region not known yet. An earlier "Accept" is valid anywhere, so act
        // on it now; otherwise wait for the lookup rather than flash a banner
        // at a US visitor. resolveRegion() calls back into apply().
        if (stored === 'granted') loadGA();
        resolveRegion().then(apply);
        return;
      }
      if (!consentRequired()) {
        // US: load immediately unless the visitor previously opted out.
        if (stored !== 'denied') loadGA();
        return;
      }
      // Gated region.
      if (stored === 'granted') {
        loadGA();
        hideBanner();
      } else if (stored === 'denied') {
        hideBanner();
      } else {
        showBanner();
      }
    }

    // Banner buttons (delegated so it survives View Transition DOM swaps).
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      if (t.closest('[data-consent-accept]')) {
        e.preventDefault();
        grant();
      } else if (t.closest('[data-consent-decline]')) {
        e.preventDefault();
        deny();
      } else if (t.closest('[data-consent-manage]')) {
        // Footer "Cookie settings" — reopen the banner to change the choice.
        e.preventDefault();
        showBanner();
      }
    });

    // Run on initial load and after each View Transition navigation.
    // astro:page-load fires on initial load too, so skip sendPageView() on the
    // first event — loadGA() inside apply() already sends it on initial render.
    var initialPageLoadHandled = false;
    document.addEventListener('astro:page-load', function () {
      apply();
      if (initialPageLoadHandled) {
        sendPageView();
      }
      initialPageLoadHandled = true;
    });
    apply();
  })();
</script>
