---
import CognitoForm from '~/components/widgets/CognitoForm.astro';
import Features2 from '~/components/widgets/Features2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Layout from '~/layouts/PageLayout.astro';
import membershipSettings from '~/data/settings/membership.json';
import { renderInlineMarkdown } from '~/utils/markdown';

const benefits = membershipSettings.benefits.map((b) => ({ ...b, description: renderInlineMarkdown(b.description) }));

const metadata = {
  title: membershipSettings.heroTitle,
  description:
    'Join the Eastern Cooperative Recreation School and enjoy members-only discounts, voting rights, our newsletter ECHOES, and more.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline={membershipSettings.heroTagline} title={membershipSettings.heroTitle} />

  <Features2 title={membershipSettings.benefitsTitle} columns={2} items={benefits} />

  <!-- Pricing -->
  <WidgetWrapper id="pricing" containerClass="max-w-4xl">
    <Headline
      title={membershipSettings.pricingTitle}
      subtitle={renderInlineMarkdown(membershipSettings.pricingIntro)}
      classes={{ subtitle: 'text-base' }}
    />
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      {
        membershipSettings.pricingTiers.map((tier) => (
          <div
            class:list={[
              'rounded-xl p-6',
              tier.featured
                ? 'border-2 border-accent bg-accent/5'
                : 'border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-900',
            ]}
          >
            <h3 class="font-bold text-lg mb-1 text-heading">{tier.title}</h3>
            <p class="text-muted text-sm mb-4">{tier.subtitle}</p>
            <p class="font-heading text-4xl font-bold text-primary">{tier.price}</p>
          </div>
        ))
      }
    </div>
  </WidgetWrapper>

  <!-- Cognito Forms embed -->
  <section id="membership-form" class="py-8 px-4 max-w-3xl mx-auto">
    <h2 class="font-heading text-2xl font-bold text-center mb-6 text-heading">{membershipSettings.formHeading}</h2>
    <p class="text-center text-muted mb-4">
      <Fragment set:html={renderInlineMarkdown(membershipSettings.formNote)} />{' '}
      <a href={`mailto:${membershipSettings.formNoteEmail}`} class="text-link underline">
        {membershipSettings.formNoteEmail}
      </a>
    </p>
  </section>
  <CognitoForm formId={membershipSettings.cognitoFormId} formName="membership" id="join" />
</Layout>
