---
// The whole book on one page, for scripts/render-book-pdf.mjs to print to
// public/docs/of-play-and-playfulness.pdf. Every chapter shares this page, so
// ids are prefixed with the chapter slug and links between chapters point
// within the document. Not in search or the sitemap: the chapters are.
import Layout from '~/layouts/PageLayout.astro';
import settings from '~/data/settings/of-play-and-playfulness.json';
import {
  anchorId,
  chapterHtml,
  chapters,
  demoteHeadings,
  localizeAnchors,
  replaceMarks,
  rewriteImageSources,
  titleImagePath,
} from '~/utils/ofPlayAndPlayfulness';
import { optimizeBookImage } from '~/utils/ofPlayAndPlayfulnessImages';
import '~/assets/styles/of-play-and-playfulness.css';

const book = await Promise.all(
  chapters.map(async (ch, i) => ({
    ...ch,
    number: i + 1,
    art: await optimizeBookImage(titleImagePath(ch)),
    html: demoteHeadings(
      localizeAnchors(await rewriteImageSources(replaceMarks(chapterHtml(ch.slug)), optimizeBookImage), ch.slug)
    ),
  }))
);

const metadata = {
  title: `${settings.heroTitle} (print edition)`,
  description: settings.introText,
};
---

<Layout metadata={metadata} noIndex>
  <Fragment slot="header" />
  <Fragment slot="footer" />

  <div class="opp-print mx-auto max-w-3xl px-4 sm:px-6">
    <section class="opp-cover">
      <div class="opp-cover-art" aria-hidden="true">
        {[book[2], book[5], book[6], book[4]].map((c) => (
          <img src={c.art} alt="" width={c.titleImageWidth} height={c.titleImageHeight} class="opp-art" />
        ))}
      </div>
      <h1 class="font-heading text-5xl font-bold tracking-tight text-heading">{settings.heroTitle}</h1>
      <p class="mt-3 text-xl text-muted">{settings.heroSubtitle}</p>
      <p class="mt-auto font-semibold text-heading">Eastern Cooperative Recreation School</p>
      <img src="/images/ecrs-logo.svg" alt="ECRS" width="227" height="210" class="mx-auto mt-4 h-20 w-auto" />
      <p class="mt-6 text-sm text-muted">{settings.printEditionNote}</p>
    </section>

    <nav class="opp-toc" aria-labelledby="opp-toc-title">
      <h2 id="opp-toc-title" class="font-heading text-3xl font-bold text-heading">
        {settings.contentsTitle}
      </h2>
      <p class="mt-4 text-default">{settings.introText}</p>
      <ol class="mt-8" role="list">
        {book.map((c) => (
          <li>
            <a href={`#${anchorId(c.slug)}`}>
              <span class="opp-toc-number">{c.number}</span>
              <span class="opp-toc-title">{c.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {book.map((c) => (
      <section id={anchorId(c.slug)} class="opp-chapter">
        <header class="text-center">
          <!-- Visible text, so the PDF's bookmarks pick the chapter up; the art is the title as drawn. -->
          <h2 class="text-sm font-semibold tracking-wide text-secondary">
            Chapter {c.number}: {c.title}
          </h2>
          <img
            src={c.art}
            alt=""
            width={c.titleImageWidth}
            height={c.titleImageHeight}
            class="opp-art mx-auto mt-4 h-auto w-auto max-h-36 max-w-full"
          />
          {c.quote && (
            <figure class="mx-auto mt-6 max-w-xl">
              <blockquote class="text-lg italic leading-relaxed text-heading">{c.quote}</blockquote>
              {c.attribution && <figcaption class="mt-2 text-sm text-muted">{c.attribution}</figcaption>}
            </figure>
          )}
        </header>
        <div
          class="opp-book prose mt-8 max-w-none prose-headings:font-heading prose-a:text-primary"
          set:html={c.html}
        />
      </section>
    ))}
  </div>
</Layout>

<style>
  .opp-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 9in;
    padding: 0.5in 0 0;
  }
  .opp-cover-art {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 1.5rem 2.5rem;
    margin-bottom: 3rem;
  }
  .opp-cover-art img {
    max-height: 5.5rem;
    width: auto;
    margin: 0 auto;
  }
  .opp-toc {
    padding-top: 2rem;
  }
  .opp-toc li a {
    display: flex;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid rgb(229 231 235);
    color: inherit;
    text-decoration: none;
  }
  .opp-toc-number {
    width: 2rem;
    color: var(--aw-color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .opp-toc-title {
    font-weight: 600;
  }
  .opp-chapter {
    padding-top: 3rem;
  }

  @page {
    size: letter;
    margin: 0.75in 0.85in 0.8in;
  }
  @media print {
    :global(html) {
      font-size: 11pt;
    }
    :global(#consent-banner),
    :global([data-back-to-top]) {
      display: none !important;
    }
    :global(html),
    :global(body) {
      background: #fff !important;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    .opp-print {
      max-width: none;
      padding: 0;
    }
    .opp-cover,
    .opp-toc {
      break-after: page;
    }
    .opp-chapter {
      break-before: page;
      padding-top: 0;
    }
    .opp-print :global(h2),
    .opp-print :global(h3),
    .opp-print :global(dt) {
      break-after: avoid;
    }
    .opp-print :global(dl),
    .opp-print :global(figure),
    .opp-print :global(img),
    .opp-print :global(.opp-center),
    .opp-print :global(.opp-table) {
      break-inside: avoid;
    }
    .opp-print :global(p) {
      orphans: 3;
      widows: 3;
    }
    .opp-print :global(.prose) {
      line-height: 1.6;
    }
    .opp-print :global(p:has(> .opp-tag-lead:only-child)) {
      break-after: avoid;
    }
  }
</style>
