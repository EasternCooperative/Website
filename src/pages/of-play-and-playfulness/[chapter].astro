---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import LeaderPopover from '~/components/ui/LeaderPopover.astro';
import BookSearch from '~/components/book/BookSearch.astro';
import settings from '~/data/settings/of-play-and-playfulness.json';
import {
  BOOK_PATH,
  BOOK_PDF_PATH,
  chapterHtml,
  chapterPath,
  chapters,
  linkLeaders,
  replaceMarks,
  rewriteImageSources,
  separateBlocks,
  titleImagePath,
  type Chapter,
} from '~/utils/ofPlayAndPlayfulness';
import { optimizeBookImage } from '~/utils/ofPlayAndPlayfulnessImages';
import { BOOK_FILTER } from '~/utils/bookSearch';
import { publicFileSize } from '~/utils/fileSize';
import siteSettings from '~/data/settings/site.json';
import '~/assets/styles/of-play-and-playfulness.css';

export const getStaticPaths = (() =>
  chapters.map((chapter, i) => ({
    params: { chapter: chapter.slug },
    props: { chapter, number: i + 1, prev: chapters[i - 1], next: chapters[i + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  chapter: Chapter;
  number: number;
  prev?: Chapter;
  next?: Chapter;
}

const { chapter, number, prev, next } = Astro.props;

// Leaders the book names get the same hover card as on the schedule, held to
// the same rule: people with a bio, unless the site shows everyone.
const leaderRecords = (await getCollection('leader')).filter(
  (l) => siteSettings.featureFlags.peopleWithoutPhotoOrBio || !!l.data.bio
);
const leaderMap = new Map(leaderRecords.map((l) => [l.id, l.data]));

// Marks first: they are recognized by their original file names.
const { html, ids: mentionedLeaders } = linkLeaders(
  await rewriteImageSources(separateBlocks(replaceMarks(chapterHtml(chapter.slug))), optimizeBookImage),
  leaderRecords.map((l) => ({ id: l.id, name: l.data.name }))
);
const titleArt = await optimizeBookImage(titleImagePath(chapter));
const pdfSize = publicFileSize(BOOK_PDF_PATH);

const metadata = {
  title: `${chapter.title} | ${settings.heroTitle}`,
  description: chapter.quote
    ? `${chapter.quote}${chapter.attribution ? ` - ${chapter.attribution}` : ''}`
    : `Chapter ${number} of ${settings.heroTitle}.`,
  openGraph: { images: [{ url: '/og/default.jpg', width: 1200, height: 630 }] },
};

const linkBase = 'text-default hover:text-primary transition-colors';
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-14 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-14">
    <!-- The whole book's contents. Each chapter's sections fold away under its
         button; this chapter's start open, and its row stays pinned at the top
         while you scroll through them, so the button is always in reach. -->
    <aside class="hidden lg:block" aria-label="Book contents" data-pagefind-ignore="all">
      <div class="opp-sidebar sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pb-6 pr-2 text-sm">
        <a href={BOOK_PATH} class="font-heading text-base font-bold text-heading hover:text-primary">
          {settings.heroTitle}
        </a>
        <button type="button" data-opp-search-open class="opp-chip mt-3">
          <Icon name="tabler:search" class="h-4 w-4 shrink-0" aria-hidden="true" />
          {settings.searchLabel}
        </button>
        <ol class="mt-4 border-l border-gray-200 dark:border-white/10" role="list">
          {chapters.map((ch) => {
            const current = ch.slug === chapter.slug;
            const listId = `opp-nav-${ch.slug}`;
            return (
              <li>
                <div class:list={['opp-sidebar-row flex items-center', { 'opp-sidebar-current': current }]}>
                  <a
                    href={chapterPath(ch.slug)}
                    aria-current={current ? 'page' : undefined}
                    class:list={[
                      'block min-w-0 flex-1 py-1 pl-3',
                      current ? '-ml-px border-l-2 border-primary font-semibold text-primary' : linkBase,
                    ]}
                  >
                    {ch.title}
                  </a>
                  {ch.sections.length > 0 && (
                    <button
                      type="button"
                      data-opp-toggle
                      aria-controls={listId}
                      aria-expanded={current ? 'true' : 'false'}
                      aria-label={`Sections in ${ch.title}`}
                      class="opp-toggle ml-1 shrink-0 rounded p-1 text-muted transition hover:bg-gray-100 hover:text-heading dark:hover:bg-white/10"
                    >
                      <Icon name="tabler:chevron-down" class="h-4 w-4" aria-hidden="true" />
                    </button>
                  )}
                </div>
                {ch.sections.length > 0 && (
                  <ul id={listId} class="mb-2 mt-1 space-y-1 pl-6" role="list" hidden={!current}>
                    {ch.sections.map((s) => (
                      <li>
                        <a
                          href={current ? `#${s.id}` : `${chapterPath(ch.slug)}#${s.id}`}
                          class={`block py-0.5 text-muted ${linkBase}`}
                        >
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
        <a
          href={BOOK_PDF_PATH}
          download
          class="mt-6 inline-flex items-center gap-2 pl-3 font-medium text-primary hover:underline"
        >
          <Icon name="tabler:download" class="h-4 w-4" aria-hidden="true" />
          {settings.downloadLabel}
          {pdfSize && <span class="text-muted">({pdfSize})</span>}
        </a>
      </div>
    </aside>

    <article class="min-w-0 max-w-3xl" data-pagefind-filter={`book:${BOOK_FILTER}`}>
      <div class="mb-8 flex flex-wrap items-center justify-between gap-3" data-pagefind-ignore="all">
        <nav aria-label="Breadcrumb">
          <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0 text-sm text-muted">
            <li>
              <a href={BOOK_PATH} class="transition-colors hover:text-primary">
                {settings.heroTitle}
              </a>
            </li>
            <li aria-hidden="true" class="text-muted/50">
              /
            </li>
            <li aria-current="page" class="text-default">
              {chapter.title}
            </li>
          </ol>
        </nav>
        <div class="flex gap-2 lg:hidden">
          <button type="button" data-opp-search-open class="opp-chip">
            <Icon name="tabler:search" class="h-4 w-4" aria-hidden="true" />
            Search
          </button>
          <a href={BOOK_PDF_PATH} download class="opp-chip">
            <Icon name="tabler:download" class="h-4 w-4" aria-hidden="true" />
            PDF
          </a>
        </div>
      </div>

      <header class="text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-secondary" data-pagefind-ignore>
          Chapter {number} <span class="text-muted">of {chapters.length}</span>
        </p>
        <h1 class="mt-4">
          <span class="sr-only" data-pagefind-meta="title">
            {chapter.title}
          </span>
          <img
            src={titleArt}
            alt=""
            aria-hidden="true"
            width={chapter.titleImageWidth}
            height={chapter.titleImageHeight}
            class="opp-art mx-auto h-auto w-auto max-h-36 max-w-full"
            loading="eager"
            fetchpriority="high"
          />
        </h1>
        {chapter.quote && (
          <figure class="mx-auto mt-8 max-w-xl">
            <blockquote class="text-lg italic leading-relaxed text-heading md:text-xl">{chapter.quote}</blockquote>
            {chapter.attribution && <figcaption class="mt-2 text-sm text-muted">{chapter.attribution}</figcaption>}
          </figure>
        )}
      </header>

      {chapter.sections.length > 0 && (
        <details
          data-pagefind-ignore="all"
          class="group mt-10 rounded-xl border border-gray-200 bg-white lg:hidden dark:border-white/10 dark:bg-white/5"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 font-semibold text-heading">
            <span>
              {settings.inThisChapterTitle}
              <span class="ml-1 font-normal text-muted">({chapter.sections.length})</span>
            </span>
            <Icon name="tabler:chevron-down" class="h-5 w-5 transition group-open:rotate-180" aria-hidden="true" />
          </summary>
          <ul
            class="grid gap-x-4 gap-y-1 border-t border-gray-200 px-4 py-3 text-sm sm:grid-cols-2 dark:border-white/10"
            role="list"
          >
            {chapter.sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="block py-1 text-primary">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <div
        class="opp-book prose prose-lg mt-10 max-w-none dark:prose-invert prose-headings:font-heading prose-a:text-primary"
        set:html={html}
      />

      <nav aria-label="Chapters" class="mt-16 grid gap-4 sm:grid-cols-2" data-pagefind-ignore="all">
        {prev ? (
          <a href={chapterPath(prev.slug)} class="opp-pager group">
            <span class="flex items-center gap-1 text-sm text-muted">
              <Icon
                name="tabler:arrow-left"
                class="h-4 w-4 transition group-hover:-translate-x-0.5"
                aria-hidden="true"
              />
              Previous chapter
            </span>
            <span class="font-heading text-lg font-bold text-heading group-hover:text-primary">{prev.title}</span>
          </a>
        ) : (
          <a href={BOOK_PATH} class="opp-pager group">
            <span class="flex items-center gap-1 text-sm text-muted">
              <Icon name="tabler:arrow-left" class="h-4 w-4" aria-hidden="true" />
              Back to
            </span>
            <span class="font-heading text-lg font-bold text-heading group-hover:text-primary">
              {settings.contentsTitle}
            </span>
          </a>
        )}
        {next ? (
          <a href={chapterPath(next.slug)} class="opp-pager group sm:col-start-2 sm:text-right">
            <span class="flex items-center gap-1 text-sm text-muted sm:justify-end">
              Next chapter
              <Icon
                name="tabler:arrow-right"
                class="h-4 w-4 transition group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </span>
            <span class="font-heading text-lg font-bold text-heading group-hover:text-primary">{next.title}</span>
          </a>
        ) : (
          <a href={BOOK_PATH} class="opp-pager group sm:col-start-2 sm:text-right">
            <span class="flex items-center gap-1 text-sm text-muted sm:justify-end">
              Back to
              <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
            </span>
            <span class="font-heading text-lg font-bold text-heading group-hover:text-primary">
              {settings.contentsTitle}
            </span>
          </a>
        )}
      </nav>
    </article>
  </div>

  {mentionedLeaders.length > 0 && (
    <div class="no-print" data-pagefind-ignore="all">
      {mentionedLeaders.map((id) => (
        <LeaderPopover id={id} leader={leaderMap.get(id)!} />
      ))}
    </div>
  )}

  <BookSearch />
</Layout>

<script>
  import { initLeaderPopovers } from '~/utils/eventPageInteractions';

  // Runs on the first load and after each view-transition navigation.
  document.addEventListener('astro:page-load', initLeaderPopovers);
</script>
