---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import settings from '~/data/settings/of-play-and-playfulness.json';
import { chapters, chapterPath } from '~/utils/ofPlayAndPlayfulness';
import '~/assets/styles/of-play-and-playfulness.css';

const metadata = {
  title: settings.heroTitle,
  description: settings.introText,
  openGraph: { images: [{ url: '/og/default.jpg', width: 1200, height: 630 }] },
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline={settings.heroTagline}
    title={settings.heroTitle}
    subtitle={settings.heroSubtitle}
    content={settings.introText}
  />

  <!-- HeroText has no bottom padding of its own; this section owns the gap. -->
  <WidgetWrapper containerClass="max-w-3xl pt-8 md:pt-10 lg:pt-12">
    <h2 class="font-heading text-2xl font-bold text-heading mb-6">{settings.contentsTitle}</h2>
    <ol class="grid gap-6" role="list">
      {chapters.map((ch, i) => (
        <li class="border-t border-gray-200 pt-5 dark:border-gray-700">
          <p class="text-sm font-semibold uppercase tracking-wide text-muted">Chapter {i + 1}</p>
          <h3 class="mt-1 text-xl font-bold">
            <a
              href={chapterPath(ch.slug)}
              class="text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
            >
              {ch.title}
            </a>
          </h3>
          {ch.quote && (
            <p class="mt-2 text-muted">
              <i>{ch.quote}</i>
              {ch.attribution && <span> - {ch.attribution}</span>}
            </p>
          )}
          {ch.sections.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm" aria-label={`In ${ch.title}`}>
              {ch.sections.map((s) => (
                <li>
                  <a href={`${chapterPath(ch.slug)}#${s.id}`} class="text-primary hover:underline">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </WidgetWrapper>
</Layout>
