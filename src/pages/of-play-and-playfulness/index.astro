---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import settings from '~/data/settings/of-play-and-playfulness.json';
import {
  BOOK_PDF_PATH,
  activityIndex,
  chapterPath,
  chapters,
  groupByInitial,
  titleImagePath,
} from '~/utils/ofPlayAndPlayfulness';
import { optimizeBookImage } from '~/utils/ofPlayAndPlayfulnessImages';
import { publicFileSize } from '~/utils/fileSize';
import '~/assets/styles/of-play-and-playfulness.css';

const metadata = {
  title: settings.heroTitle,
  description: settings.introText,
  openGraph: { images: [{ url: '/og/default.jpg', width: 1200, height: 630 }] },
};

const pdfSize = publicFileSize(BOOK_PDF_PATH);
const cards = await Promise.all(
  chapters.map(async (ch, i) => ({ ...ch, number: i + 1, art: await optimizeBookImage(titleImagePath(ch)) }))
);

const index = groupByInitial(activityIndex());
---

<Layout metadata={metadata}>
  <section class="not-prose mx-auto max-w-6xl px-4 pt-10 sm:px-6 md:pt-14">
    <div class="grid items-center gap-10 md:grid-cols-[minmax(0,1fr)_18rem]">
      <div>
        <p class="text-base font-bold uppercase tracking-wide text-secondary">{settings.heroTagline}</p>
        <h1 class="mt-2 font-heading text-5xl font-bold leading-tighter tracking-tighter text-heading md:text-6xl">
          {settings.heroTitle}
        </h1>
        <p class="mt-3 text-xl text-muted">{settings.heroSubtitle}</p>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-default">{settings.introText}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={chapterPath(chapters[0].slug)} class="btn btn-primary">
            <Icon name="tabler:book" class="mr-2 h-5 w-5" aria-hidden="true" />
            {settings.startReadingLabel}
          </a>
          <a href={BOOK_PDF_PATH} class="btn" download>
            <Icon name="tabler:download" class="mr-2 h-5 w-5" aria-hidden="true" />
            {settings.downloadLabel}
            {pdfSize && <span class="ml-1.5 text-sm text-muted">(PDF, {pdfSize})</span>}
          </a>
        </div>
      </div>
      <!-- Three of the book's hand-lettered titles, stacked like a spine label. -->
      <div
        class="hidden md:grid gap-6 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200 dark:bg-white/5 dark:ring-white/10"
        aria-hidden="true"
      >
        {[cards[2], cards[5], cards[4]].map((c) => (
          <img
            src={c.art}
            alt=""
            width={c.titleImageWidth}
            height={c.titleImageHeight}
            class="opp-art mx-auto max-h-24 w-auto"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="not-prose mx-auto max-w-6xl px-4 pt-14 sm:px-6 md:pt-20" aria-labelledby="opp-contents">
    <h2 id="opp-contents" class="font-heading text-3xl font-bold text-heading">
      {settings.contentsTitle}
    </h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {cards.map((c) => (
        <li>
          <a
            href={chapterPath(c.slug)}
            class="group flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-primary hover:shadow-md focus-visible:outline-2 focus-visible:outline-primary dark:border-white/10 dark:bg-white/5"
          >
            <span class="flex h-24 items-center justify-center" aria-hidden="true">
              <img
                src={c.art}
                alt=""
                width={c.titleImageWidth}
                height={c.titleImageHeight}
                loading="lazy"
                class="opp-art max-h-24 w-auto max-w-full"
              />
            </span>
            <span class="mt-4 text-xs font-semibold uppercase tracking-wide text-muted">Chapter {c.number}</span>
            <span class="font-heading text-xl font-bold text-heading group-hover:text-primary">{c.title}</span>
            {c.quote && (
              <span class="mt-2 line-clamp-3 text-sm italic text-muted">
                {c.quote}
                {c.attribution && <span class="not-italic"> - {c.attribution}</span>}
              </span>
            )}
            {c.sections.length > 0 && (
              <span class="mt-auto flex items-center gap-1 pt-4 text-sm font-medium text-primary">
                {c.sections.length} {c.sections.length === 1 ? 'section' : 'sections'}
                <Icon
                  name="tabler:arrow-right"
                  class="h-4 w-4 transition group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
            )}
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="not-prose mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20" aria-labelledby="opp-index">
    <h2 id="opp-index" class="font-heading text-3xl font-bold text-heading">
      {settings.indexTitle}
    </h2>
    <p class="mt-2 text-muted">{settings.indexIntro}</p>
    <div class="mt-6 gap-8 sm:columns-2 lg:columns-3">
      {index.map(([letter, entries]) => (
        <div class="mb-6 break-inside-avoid">
          <h3 class="font-heading text-lg font-bold text-secondary">{letter}</h3>
          <ul class="mt-1 space-y-1" role="list">
            {entries.map((e) => (
              <li>
                <a
                  href={e.href}
                  class="text-primary underline decoration-primary/30 underline-offset-2 hover:decoration-primary"
                >
                  {e.label}
                </a>
                <span class="text-sm text-muted"> ({e.chapter})</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
