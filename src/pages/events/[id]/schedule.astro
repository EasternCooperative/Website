---
import { existsSync } from 'node:fs';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { buildEventMasterSchedule, hasMasterSchedule, baseEventTitle } from '~/utils/eventSchedule';
import { buildScheduleGrid } from '~/components/schedule/scheduleGrid';

export async function getStaticPaths() {
  const events = await getCollection('event');
  return events
    .filter((event) => hasMasterSchedule(event.data).ok)
    .map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props {
  event: CollectionEntry<'event'>;
}

const { event } = Astro.props;
const { data } = event;

const leaders = await getCollection('leader');
const leaderMap = new Map(leaders.map((l) => [l.id, l.data]));

const grid = buildScheduleGrid(buildEventMasterSchedule(data, leaderMap));
const year = data.date.getUTCFullYear();
const eventLabel = `${baseEventTitle(data.title)} ${year}`;

const metadata = {
  title: `${eventLabel} — Master Schedule`,
  description: `Printable class schedule for ${eventLabel}.`,
};

// Static PDF rendered from this page in CI (scripts/render-schedule-pdfs.mjs).
const schedulePdfPath = `/schedules/${event.id}.pdf`;
const schedulePdfExists = existsSync(`public${schedulePdfPath}`);

const cellText = (item?: { name: string; leader: string }) => item;
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="no-print mb-6 flex flex-wrap items-center gap-3">
      <a
        href={`/events/${event.id}`}
        class="text-sm text-muted underline decoration-dotted underline-offset-2 hover:text-primary"
      >
        ← Back to event
      </a>
      <span class="flex-1"></span>
      {
        schedulePdfExists && (
          <a
            href={schedulePdfPath}
            class="rounded-full bg-primary px-4 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-secondary"
          >
            Download PDF
          </a>
        )
      }
    </div>

    <h1 class="font-heading mb-1 text-3xl font-bold text-heading">{eventLabel} — Master Schedule</h1>
    <p class="mb-6 text-sm text-muted">Class times and rooms.</p>

    <div class="overflow-x-auto">
      <table class="schedule-grid w-full border-collapse text-sm">
        <thead>
          <tr>
            <th class="border px-3 py-2 text-left">Time</th>
            <th class="border px-3 py-2 text-left">Days</th>
            {grid.locations.map((loc) => <th class="border px-3 py-2 text-left">{loc}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            grid.rows.map((row) =>
              row.kind === 'break' ? (
                <tr class="schedule-break">
                  <td class="border px-3 py-2 text-center font-semibold" colspan={2 + grid.locations.length}>
                    {row.timeText ? `${row.label} · ${row.timeText}` : row.label}
                  </td>
                </tr>
              ) : (
                <>
                  <tr>
                    <td class="border px-3 py-2 align-middle font-semibold" rowspan={2}>
                      {row.timeText || row.displayName}
                    </td>
                    <td class="border px-3 py-2 text-xs text-muted whitespace-nowrap">
                      Days
                      <br />
                      1–2
                    </td>
                    {row.cells.map((cell) =>
                      cell.fourDay ? (
                        <td class="border px-3 py-2 align-middle" rowspan={2}>
                          <span class="font-semibold text-heading">{cell.fourDay.name}</span>
                          {cell.fourDay.leader && (
                            <span class="block text-xs text-muted italic">{cell.fourDay.leader}</span>
                          )}
                        </td>
                      ) : cellText(cell.half12) ? (
                        <td class="border px-3 py-2">
                          <span class="font-semibold text-heading">{cell.half12!.name}</span>
                          {cell.half12!.leader && (
                            <span class="block text-xs text-muted italic">{cell.half12!.leader}</span>
                          )}
                        </td>
                      ) : (
                        <td class="border px-3 py-2">&nbsp;</td>
                      )
                    )}
                  </tr>
                  <tr>
                    <td class="border px-3 py-2 text-xs text-muted whitespace-nowrap">
                      Days
                      <br />
                      3–4
                    </td>
                    {row.cells.map((cell) =>
                      cell.fourDay ? null : cellText(cell.half34) ? (
                        <td class="border px-3 py-2">
                          <span class="font-semibold text-heading">{cell.half34!.name}</span>
                          {cell.half34!.leader && (
                            <span class="block text-xs text-muted italic">{cell.half34!.leader}</span>
                          )}
                        </td>
                      ) : (
                        <td class="border px-3 py-2">&nbsp;</td>
                      )
                    )}
                  </tr>
                </>
              )
            )
          }
        </tbody>
      </table>
    </div>
  </section>
</Layout>

{grid.landscape && <style is:inline set:html="@media print { @page { size: landscape; } }" />}

<style>
  .schedule-grid th,
  .schedule-grid td {
    border-color: #d1d5db;
    vertical-align: middle;
  }
  .schedule-grid thead th,
  .schedule-break td {
    background: #f3f4f6;
    /* Keep the fills when printing, without relying on the browser's
       "Background graphics" checkbox. */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .schedule-grid tr {
    page-break-inside: avoid;
  }

  @media print {
    :global(header),
    :global(footer),
    :global(#consent-banner),
    .no-print {
      display: none !important;
    }
    :global(main) {
      padding: 0 !important;
    }
    /* Trim the page furniture above the table so the grid fits one page.
       The table itself keeps its on-screen size. */
    @page {
      margin: 0.4in;
    }
    section {
      max-width: none !important;
      padding: 0 !important;
    }
    h1 {
      margin-bottom: 0.6rem !important;
      font-size: 1.4rem !important;
    }
    section > p {
      display: none !important;
    }
    /* With border-collapse, the shared line between two adjacent filled break
       rows (Lunch / Free Time) gets painted over by the cell backgrounds in
       some print engines. Switch to separate borders for print — never covered
       by a background. The outer frame lives on the <table> itself (a cell's
       right/bottom edge can get clipped at the printable area); cells draw the
       internal right + bottom lines. */
    .schedule-grid {
      border-collapse: separate;
      border-spacing: 0;
      border: 1px solid #9ca3af;
    }
    .schedule-grid th,
    .schedule-grid td {
      border-width: 0 1px 1px 0 !important;
      border-color: #9ca3af !important;
    }
  }
</style>
