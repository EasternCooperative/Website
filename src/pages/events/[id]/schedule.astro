---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { buildEventMasterSchedule, hasMasterSchedule, baseEventTitle } from '~/utils/eventSchedule';
import { buildScheduleGrid } from '~/components/schedule/scheduleGrid';

export async function getStaticPaths() {
  const events = await getCollection('event');
  return events
    .filter((event) => hasMasterSchedule(event.data).ok)
    .map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props {
  event: CollectionEntry<'event'>;
}

const { event } = Astro.props;
const { data } = event;

const leaders = await getCollection('leader');
const leaderMap = new Map(leaders.map((l) => [l.id, l.data]));

const grid = buildScheduleGrid(buildEventMasterSchedule(data, leaderMap));
const year = data.date.getUTCFullYear();
const eventLabel = `${baseEventTitle(data.title)} ${year}`;

const metadata = {
  title: `${eventLabel} — Master Schedule`,
  description: `Printable class schedule for ${eventLabel}.`,
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="no-print mb-6 flex flex-wrap items-center gap-3">
      <a
        href={`/events/${event.id}`}
        class="text-sm text-muted underline decoration-dotted underline-offset-2 hover:text-primary"
      >
        ← Back to event
      </a>
      <span class="flex-1"></span>
      <button
        type="button"
        id="print-schedule"
        class="cursor-pointer rounded-full border border-gray-300 px-4 py-1.5 text-sm text-default transition-colors hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-800"
      >
        Print
      </button>
      <a
        href={`/events/${event.id}/schedule.pdf`}
        class="rounded-full bg-primary px-4 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-secondary"
      >
        Download PDF
      </a>
    </div>

    <h1 class="font-heading mb-1 text-3xl font-bold text-heading">{eventLabel} — Master Schedule</h1>
    <p class="mb-6 text-sm text-muted">Class times and rooms.</p>

    <div class="overflow-x-auto">
      <table class="schedule-grid w-full border-collapse text-sm">
        <thead>
          <tr>
            <th class="border px-3 py-2 text-left">Time</th>
            {grid.locations.map((loc) => <th class="border px-3 py-2 text-left">{loc}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            grid.rows.map((row) =>
              row.kind === 'break' ? (
                <tr class="schedule-break">
                  <td class="border px-3 py-2 text-center font-semibold" colspan={1 + grid.locations.length}>
                    {row.timeText ? `${row.label} · ${row.timeText}` : row.label}
                  </td>
                </tr>
              ) : (
                <tr>
                  <td class="border px-3 py-2 font-semibold whitespace-nowrap">{row.timeText || row.displayName}</td>
                  {row.cells.map((cell) => (
                    <td class="border px-3 py-2">
                      {cell.entries.length === 0 ? (
                        <span>&nbsp;</span>
                      ) : (
                        cell.entries.map((e, i) => (
                          <div class={i > 0 ? 'mt-2' : ''}>
                            {e.dayLabel && <span class="text-xs text-muted">{e.dayLabel} </span>}
                            <span class="font-semibold text-heading">{e.name}</span>
                            {e.leader && <span class="block text-xs text-muted italic">{e.leader}</span>}
                          </div>
                        ))
                      )}
                    </td>
                  ))}
                </tr>
              )
            )
          }
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<script>
  document.getElementById('print-schedule')?.addEventListener('click', () => window.print());
</script>

{grid.landscape && <style is:inline set:html="@media print { @page { size: landscape; } }" />}

<style>
  .schedule-grid th,
  .schedule-grid td {
    border-color: #d1d5db;
    vertical-align: middle;
  }
  .schedule-grid thead th {
    background: #f3f4f6;
  }
  .schedule-break td {
    background: #f3f4f6;
  }
  .schedule-grid tr {
    page-break-inside: avoid;
  }

  @media print {
    :global(header),
    :global(footer),
    :global(#consent-banner),
    .no-print {
      display: none !important;
    }
    :global(main) {
      padding: 0 !important;
    }
    @page {
      margin: 0.4in;
    }
    section {
      max-width: none !important;
      padding: 0 !important;
    }
    h1 {
      margin-bottom: 0.15rem !important;
      font-size: 1.3rem !important;
    }
  }
</style>
