---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import EventCard from '~/components/widgets/EventCard.astro';
import RollingLabel from '~/components/common/RollingLabel.astro';
import RangeSlider from '~/components/ui/RangeSlider.astro';
import eventsListSettings from '~/data/settings/events-list.json';
import { formatEventDateRange } from '~/utils/dates';
import { resolveVenue } from '~/utils/resolveEvent';
import { computeEventSections } from '~/utils/eventSections';
import { resolveClassLeaderNames } from '~/utils/classes';
import { renderInlineMarkdown, stripMarkdown } from '~/utils/markdown';

const allEvents = await getCollection('event', ({ data }) => !data.draft);
const allSites = await getCollection('site');
const siteMap = new Map(allSites.map((s) => [s.id, s.data]));
const allLeaders = await getCollection('leader');
const leaderMap = new Map(allLeaders.map((l) => [l.id, l.data]));
// en-CA produces YYYY-MM-DD output (the only locale that does), which lets us
// concatenate directly into a valid ISO string. The timezone is what matters here.
const now = new Date(new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' }) + 'T00:00:00Z');

const upcoming = allEvents
  .filter((e) => (e.data.endDate ?? e.data.date) >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const past = allEvents
  .filter((e) => (e.data.endDate ?? e.data.date) < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Resolved venue name per past event doubles as the site filter's key/label —
// it already handles the siteId-vs-free-text-location fallback (resolveVenue),
// so events that predate siteId still get a sensible, distinct filter chip.
const pastVenueNames = past.map(
  (e) => resolveVenue(e.data, e.data.siteId ? siteMap.get(e.data.siteId) : undefined).location
);
const pastSites = [...new Set(pastVenueNames)].filter(Boolean).sort();
const pastYears = past.map((e) => e.data.date.getFullYear());
const pastYearBoundMin = pastYears.length ? Math.min(...pastYears) : 0;
const pastYearBoundMax = pastYears.length ? Math.max(...pastYears) : 0;

const metadata = {
  title: eventsListSettings.heroTitle,
  description: stripMarkdown(eventsListSettings.heroSubtitle),
};

const allOrdered = [...upcoming, ...past];
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ECRS Events',
  url: Astro.site ? new URL('/events', Astro.site).href : 'https://ecrs.org/events',
  itemListElement: allOrdered.map((event, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Event',
      '@id': Astro.site ? new URL(`/events/${event.id}`, Astro.site).href : `https://ecrs.org/events/${event.id}`,
      name: event.data.title,
      startDate: event.data.date.toISOString(),
      endDate: (event.data.endDate ?? event.data.date).toISOString(),
      eventStatus:
        (event.data.endDate ?? event.data.date) < now
          ? 'https://schema.org/EventPast'
          : 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: (() => {
        const v = resolveVenue(event.data, event.data.siteId ? siteMap.get(event.data.siteId) : undefined);
        return { '@type': 'Place', name: v.location, ...(v.address ? { address: v.address } : {}) };
      })(),
      audience: {
        '@type': 'PeopleAudience',
        audienceType: 'All ages, intergenerational, families',
        suggestedMinAge: 0,
      },
      ...(() => {
        const performerNames = [
          ...new Set((event.data.classes ?? []).flatMap((c) => resolveClassLeaderNames(c, leaderMap))),
        ];
        return performerNames.length > 0
          ? { performer: performerNames.map((name) => ({ '@type': 'Person', name })) }
          : {};
      })(),
      ...(event.data.excerpt ? { description: event.data.excerpt } : {}),
      image: [Astro.site ? new URL(`/og/${event.id}.jpg`, Astro.site).href : `https://ecrs.org/og/${event.id}.jpg`],
      organizer: {
        '@type': 'Organization',
        name: 'ECRS',
        url: Astro.site ? String(Astro.site) : 'https://ecrs.org',
      },
      url: Astro.site ? new URL(`/events/${event.id}`, Astro.site).href : `https://ecrs.org/events/${event.id}`,
      ...(() => {
        const { pricingRows, isPast } = computeEventSections(event.data, now);
        if (pricingRows.length === 0) return {};
        const eventUrl = Astro.site
          ? new URL(`/events/${event.id}`, Astro.site).href
          : `https://ecrs.org/events/${event.id}`;
        return {
          offers: pricingRows.map((p) => ({
            '@type': 'Offer',
            name: p.ageRange,
            price: p.fullWeekend === 'Free' ? '0' : (p.fullWeekend?.replace(/,/g, '').match(/\d+(\.\d+)?/)?.[0] ?? '0'),
            priceCurrency: 'USD',
            availability: isPast ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
            url: event.data.registrationUrl || eventUrl,
          })),
        };
      })(),
    },
  })),
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>
  <HeroText
    tagline={eventsListSettings.heroTagline}
    title={eventsListSettings.heroTitle}
    subtitle={renderInlineMarkdown(eventsListSettings.heroSubtitle)}
  />

  <!-- ============================================================
       UPCOMING EVENTS
       ============================================================ -->
  <section class="pt-6 md:pt-8 pb-12 md:pb-16 px-4 max-w-7xl mx-auto" aria-labelledby="upcoming-heading">
    <h2 id="upcoming-heading" class="font-heading text-3xl md:text-4xl font-bold text-heading mb-8">
      {eventsListSettings.upcomingHeading}
    </h2>

    {
      upcoming.length === 0 ? (
        <p class="text-muted text-lg">{eventsListSettings.emptyStateText}</p>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0" role="list">
          {upcoming.map((event: (typeof upcoming)[0]) => {
            const v = resolveVenue(event.data, event.data.siteId ? siteMap.get(event.data.siteId) : undefined);
            return (
              <li data-scroll-reveal="up">
                <EventCard
                  title={event.data.title}
                  date={formatEventDateRange(event.data.date, event.data.endDate)}
                  location={v.location}
                  href={`/events/${event.id}`}
                  image={v.image}
                  excerpt={event.data.excerpt}
                  registrationDeadline={event.data.registrationDeadline}
                  hasRegistration={!!(event.data.registrationUrl || event.data.cognitoFormId)}
                  variant="upcoming"
                />
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <!-- ============================================================
       PAST EVENTS
       ============================================================ -->
  {
    past.length > 0 && (
      <section
        class="py-12 md:py-16 px-4 max-w-7xl mx-auto border-t border-gray-200 dark:border-gray-700"
        aria-labelledby="past-heading"
      >
        <h2 id="past-heading" class="font-heading text-3xl md:text-4xl font-bold text-heading mb-8 text-muted">
          {eventsListSettings.pastHeading}
        </h2>

        {(pastYearBoundMin !== pastYearBoundMax || pastSites.length > 1) && (
          <div
            id="past-events-filters"
            class="flex flex-col gap-4 mb-8 pb-6 border-b border-gray-200 dark:border-gray-700"
          >
            {pastYearBoundMin !== pastYearBoundMax && (
              <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-5">
                <span class="text-xs font-bold uppercase tracking-widest text-muted sm:w-20 sm:shrink-0">Year</span>
                <div class="flex-1 max-w-sm">
                  <div class="flex items-center justify-between mb-2 gap-2">
                    <span class="text-xs text-muted">Range</span>
                    <span class="flex items-center gap-2">
                      <RollingLabel id="past-year-range-value" class="text-xs font-semibold text-default leading-none">
                        All years
                      </RollingLabel>
                      <button
                        type="button"
                        id="past-year-reset"
                        class="hidden text-xs text-primary hover:underline leading-none cursor-pointer"
                      >
                        Reset
                      </button>
                    </span>
                  </div>
                  <RangeSlider
                    idPrefix="past-year"
                    boundMin={pastYearBoundMin}
                    boundMax={pastYearBoundMax}
                    ariaLabelMin="Earliest year"
                    ariaLabelMax="Latest year"
                  />
                </div>
              </div>
            )}

            {pastSites.length > 1 && (
              <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-5">
                <span class="text-xs font-bold uppercase tracking-widest text-muted sm:w-20 sm:shrink-0">Site</span>
                <div class="flex flex-wrap gap-2">
                  {pastSites.map((site) => (
                    <button
                      type="button"
                      data-filter-site={site}
                      aria-pressed="false"
                      class="text-xs font-medium rounded-full px-3 py-2 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 transition-colors cursor-pointer"
                    >
                      {site}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <button
              type="button"
              id="clear-past-filters"
              class="hidden self-start text-xs font-semibold text-primary hover:underline cursor-pointer"
            >
              Clear filters
            </button>
          </div>
        )}

        <p data-past-empty-state class="hidden text-muted text-lg mb-4">
          {eventsListSettings.pastEmptyStateText}
        </p>

        <ul id="past-events-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0" role="list">
          {past.map((event: (typeof past)[0]) => {
            const v = resolveVenue(event.data, event.data.siteId ? siteMap.get(event.data.siteId) : undefined);
            return (
              <li data-scroll-reveal="up" data-year={event.data.date.getFullYear()} data-site={v.location}>
                <EventCard
                  title={event.data.title}
                  date={formatEventDateRange(event.data.date, event.data.endDate)}
                  location={v.location}
                  href={`/events/${event.id}`}
                  image={v.image}
                  variant="past"
                />
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</Layout>

<script>
  import { initPastEventsFiltersPage } from '~/utils/pastEventsFilters';

  initPastEventsFiltersPage();
</script>
