---
import CognitoForm from '~/components/widgets/CognitoForm.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Layout from '~/layouts/PageLayout.astro';
import contactSettings from '~/data/settings/contact.json';

const metadata = {
  title: contactSettings.heroTitle,
  description: contactSettings.introText,
  openGraph: { images: [{ url: '/og/default.jpg', width: 1200, height: 630 }] },
};
---

<Layout metadata={metadata}>
  <HeroText tagline={contactSettings.heroTagline} title={contactSettings.heroTitle} />

  <section class="py-8 px-4 max-w-3xl mx-auto">
    <p class="text-center text-muted">{contactSettings.introText}</p>
    <p class="text-center text-muted text-sm mt-2">
      Trouble loading the form? Email us directly at{' '}
      <a href="mailto:contact@ecrs.org" class="text-link">contact@ecrs.org</a>.
    </p>
  </section>

  <CognitoForm formId={contactSettings.cognitoFormId} formName="contact" id="contact-form" />
</Layout>
