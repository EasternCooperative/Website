---
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import MemberHeatmap from '~/components/widgets/MemberHeatmap';
import Layout from '~/layouts/PageLayout.astro';
import aboutSettings from '~/data/settings/about.json';
import memberLocations from '~/data/member-locations.json';

const metadata = {
  title: aboutSettings.heroTitle,
  description: aboutSettings.introText,
  openGraph: { images: [{ url: '/og/default.jpg', width: 1200, height: 630 }] },
};
---

<Layout metadata={metadata}>
  <HeroText tagline={aboutSettings.heroTagline} title={aboutSettings.heroTitle} />

  <Content image={{ src: aboutSettings.introImage, alt: aboutSettings.introImageAlt }}>
    <Fragment slot="content">{aboutSettings.introText}</Fragment>
  </Content>

  <Features2 title="" columns={2} items={aboutSettings.pillars} />

  <HeroText
    tagline="Our Community"
    title="ECRS Members Across the Map"
    subtitle="Our members come from all over North America. Wherever you live, you belong here."
  />

  <section class="py-8 px-4 max-w-4xl mx-auto">
    <MemberHeatmap cities={memberLocations.cities} maskSmallCounts client:load />
  </section>

  <CallToAction
    title={aboutSettings.ctaTitle}
    subtitle={aboutSettings.ctaSubtitle}
    actions={[
      { text: aboutSettings.ctaPrimaryText, href: aboutSettings.ctaPrimaryHref, variant: 'primary' },
      { text: aboutSettings.ctaSecondaryText, href: aboutSettings.ctaSecondaryHref, variant: 'secondary' },
    ]}
  />
</Layout>
