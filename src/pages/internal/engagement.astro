---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';
import LeadershipApp from '~/components/leadership/LeadershipApp';
---

<!-- Staff tool. Everything is client-rendered from /api/internal/engagement, which
     checks the Cloudflare Access JWT itself. The page shell holds no data.
     `noIndex` also keeps it out of the on-site Pagefind index. -->
<Layout
  metadata={{
    title: 'Engagement Tracker',
    description: 'Track member engagement: events, giving, membership, and leadership.',
    robots: { index: false, follow: false },
  }}
  noIndex
>
  <LeadershipApp client:only="react" />
</Layout>
