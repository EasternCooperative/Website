---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ActivityCard from '~/components/widgets/ActivityCard.astro';
import RollingLabel from '~/components/common/RollingLabel.astro';
import RangeSlider from '~/components/ui/RangeSlider.astro';
import { Icon } from 'astro-icon/components';
import activitiesListSettings from '~/data/settings/activities-list.json';
import { sentenceCase } from '~/utils/activityDisplay';
import { renderInlineMarkdown, stripMarkdown } from '~/utils/markdown';

const cardStyle = (activitiesListSettings.cardStyle ?? 'rich') as 'rich' | 'lean';

const allActivities = (await getCollection('activity', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const allTags = [...new Set(allActivities.flatMap((a) => a.data.tags ?? []))].sort();
// Posture/key/meter are single-valued per activity (unlike tags), so within
// each of these groups multiple selections combine as OR, not AND — see the
// client-side apply() logic below.
const allPostures: string[] = [
  ...new Set(allActivities.map((a) => a.data.posture).filter((v): v is NonNullable<typeof v> => !!v)),
].sort();
const allKeys = [...new Set(allActivities.map((a) => a.data.key).filter((v): v is string => !!v))].sort();
const allMeters = [...new Set(allActivities.map((a) => a.data.meter).filter((v): v is string => !!v))].sort();
const anyWheelchairAdaptable = allActivities.some((a) => a.data.seatedOrWheelchairAdaptable);
const anyCalledLive = allActivities.some((a) => a.data.isCalled);
const anyIsRound = allActivities.some((a) => a.data.isRound);
const anyBeginnerAdaptable = allActivities.some((a) => a.data.beginnerAdaptable);
// Group size is a min/max range per activity rather than a single value, so a
// slider (rather than exact-match chips like posture/meter/key) is the natural
// control — the reader picks a range and activities whose own range overlaps
// it are shown (see the overlap check in apply()).
const groupSizeValues = allActivities
  .flatMap((a) => [a.data.groupSizeMin, a.data.groupSizeMax])
  .filter((v) => v != null);
const anyGroupSizeData = groupSizeValues.length > 0;
const groupSizeBoundMin = 1;
const groupSizeBoundMax = anyGroupSizeData ? Math.max(...groupSizeValues) : 50;
// Whether the two-column facet grid (Posture/Group Size/Meter/Key/Adaptability)
// has anything to show at all — avoids rendering an empty bordered block on a
// bare catalog.
const anyGridFilters =
  allPostures.length > 0 ||
  anyWheelchairAdaptable ||
  anyGroupSizeData ||
  allMeters.length > 0 ||
  anyCalledLive ||
  allKeys.length > 0 ||
  anyIsRound ||
  anyBeginnerAdaptable;

const metadata = {
  title: activitiesListSettings.heroTitle,
  description: stripMarkdown(activitiesListSettings.heroSubtitle),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ECRS Activities',
  url: Astro.site ? new URL('/activities', Astro.site).href : 'https://ecrs.org/activities',
  itemListElement: allActivities.map((activity, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: activity.data.title,
      url: Astro.site
        ? new URL(`/activities/${activity.id}`, Astro.site).href
        : `https://ecrs.org/activities/${activity.id}`,
      ...(activity.data.excerpt ? { description: activity.data.excerpt } : {}),
    },
  })),
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>
  <HeroText
    tagline={activitiesListSettings.heroTagline}
    title={activitiesListSettings.heroTitle}
    subtitle={renderInlineMarkdown(activitiesListSettings.heroSubtitle)}
  />

  <section class="pt-6 md:pt-8 pb-12 md:pb-16 px-4 max-w-7xl mx-auto" aria-labelledby="activities-heading">
    <h2 id="activities-heading" class="sr-only">Activities</h2>

    <!-- ============================================================
         SEARCH + FILTERS
         ============================================================ -->
    <div
      id="filters-panel"
      class="sticky top-16 z-30 rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50/95 dark:bg-gray-900/95 backdrop-blur-sm p-5 md:p-6 mb-8"
    >
      <div class="flex items-center justify-between gap-4">
        <button
          type="button"
          id="filters-toggle"
          aria-expanded="true"
          aria-controls="filters-body"
          class="flex-1 flex items-center gap-1.5 py-2 -my-2 text-xs font-bold uppercase tracking-widest text-muted hover:text-primary transition-colors cursor-pointer"
        >
          <Icon
            id="filters-chevron"
            name="tabler:chevron-down"
            class="w-3.5 h-3.5 transition-transform duration-200 motion-reduce:transition-none rotate-180"
          />
          Search &amp; Filters
        </button>
        <button
          type="button"
          id="clear-all-filters"
          class="hidden py-2 -my-2 text-xs font-semibold text-primary hover:underline cursor-pointer"
        >
          Clear all filters
        </button>
      </div>

      <!-- The expanded cap is viewport-aware and the body scrolls internally, so
           on short/narrow screens (where every facet group stacks vertically) the
           panel can never grow taller than the viewport and clip content out of reach. -->
      <div
        id="filters-body"
        class="overflow-y-auto overscroll-contain transition-[max-height] duration-300 ease-in-out motion-reduce:transition-none max-h-[min(600px,calc(100dvh-10rem))]"
      >
        <div>
          <div class="relative mt-4 mb-6">
            <svg
              class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="activity-search"
              placeholder="Search activities…"
              aria-label="Search activities"
              class="w-full rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-transparent pl-10 pr-4 py-2.5 text-sm text-default placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/40"
            />
          </div>

          <div class="flex flex-col gap-4" role="group" aria-label="Filter activities">
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-5" data-filter-group="type">
              <span class="text-xs font-bold uppercase tracking-widest text-muted sm:w-20 sm:shrink-0">Type</span>
              <div class="flex flex-wrap gap-2">
                <button
                  type="button"
                  data-filter-type="all"
                  aria-pressed="true"
                  class="text-sm font-semibold rounded-full px-4 py-2.5 border transition-colors cursor-pointer bg-primary text-white border-primary"
                >
                  All
                </button>
                <button
                  type="button"
                  data-filter-type="game"
                  aria-pressed="false"
                  class="text-sm font-semibold rounded-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 transition-colors cursor-pointer"
                >
                  Games
                </button>
                <button
                  type="button"
                  data-filter-type="dance"
                  aria-pressed="false"
                  class="text-sm font-semibold rounded-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 transition-colors cursor-pointer"
                >
                  Dances
                </button>
                <button
                  type="button"
                  data-filter-type="song"
                  aria-pressed="false"
                  class="text-sm font-semibold rounded-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 transition-colors cursor-pointer"
                >
                  Songs
                </button>
              </div>
            </div>

            <!-- Posture/Group Size/Meter/Key pair up into two columns on wide screens,
             rather than each claiming a full-width row like Type/Tags do. -->
            {
              anyGridFilters && (
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                  {(allPostures.length > 0 || anyWheelchairAdaptable) && (
                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-5" data-filter-group="posture">
                      <span class="text-xs font-bold uppercase tracking-widest text-muted sm:w-20 sm:shrink-0">
                        Posture
                      </span>
                      <div class="flex flex-wrap gap-2">
                        {allPostures.map((posture) => (
                          <button
                            type="button"
                            data-filter-posture={posture}
                            data-relevant-types="game,dance"
                            aria-pressed="false"
                            class="text-xs font-medium rounded-full px-3 py-2 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 transition-colors cursor-pointer"
                          >
                            {sentenceCase(posture)}
                          </button>
                        ))}
                        {anyWheelchairAdaptable && (
                          <button
                            type="button"
                            id="filter-wheelchair-adaptable"
                            data-relevant-types="game,dance"
                            aria-pressed="false"
                            class="inline-flex items-center gap-1 text-xs font-medium rounded-full px-3 py-2 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 transition-colors cursor-pointer"
                          >
                            <Icon name="tabler:wheelchair" class="w-3.5 h-3.5" aria-hidden="true" />
                            Wheelchair Adaptable
                          </button>
                        )}
                      </div>
                    </div>
                  )}

                  {anyGroupSizeData && (
                    <div id="groupsize-filter-row" class="flex flex-col sm:flex-row sm:items-center sm:gap-5">
                      <span class="text-xs font-bold uppercase tracking-widest text-muted sm:w-20 sm:shrink-0">
                        Group Size
                      </span>
                      <div class="flex-1 max-w-sm">
                        <div class="flex items-center justify-between mb-2">
                          <span class="text-xs text-muted">People</span>
                          <RollingLabel
                            id="group-size-range-value"
                            class="text-xs font-semibold text-default leading-none"
                          >
                            Any size
                          </RollingLabel>
                        </div>
                        <RangeSlider
                          idPrefix="group-size"
                          boundMin={groupSizeBoundMin}
                          boundMax={groupSizeBoundMax}
                          ariaLabelMin="Minimum group size"
                          ariaLabelMax="Maximum group size"
                        />
                      </div>
                    </div>
                  )}

                  {allMeters.length > 0 && (
                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-5" data-filter-group="meter">
                      <span class="text-xs font-bold uppercase tracking-widest text-muted sm:w-20 sm:shrink-0">
                        Meter
                      </span>
                      <div class="flex flex-wrap gap-2">
                        {allMeters.map((meter) => (
                          <button
                            type="button"
                            data-filter-meter={meter}
                            data-relevant-types="dance"
                            aria-pressed="false"
                            class="text-xs font-medium rounded-full px-3 py-2 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 transition-colors cursor-pointer"
                          >
                            {meter}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}

                  {allKeys.length > 0 && (
                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-5" data-filter-group="key">
                      <span class="text-xs font-bold uppercase tracking-widest text-muted sm:w-20 sm:shrink-0">
                        Key
                      </span>
                      <div class="flex flex-wrap gap-2">
                        {allKeys.map((key) => (
                          <button
                            type="button"
                            data-filter-key={key}
                            data-relevant-types="song"
                            aria-pressed="false"
                            class="text-xs font-medium rounded-full px-3 py-2 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 transition-colors cursor-pointer"
                          >
                            {key}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              )
            }

            {
              allTags.length > 0 && (
                <div
                  class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-5 pt-4 border-t border-gray-200 dark:border-gray-700"
                  data-filter-group="tags"
                >
                  <span class="text-xs font-bold uppercase tracking-widest text-muted sm:w-20 sm:shrink-0">Tags</span>
                  <div class="flex flex-wrap gap-2">
                    {allTags.map((tag) => (
                      <button
                        type="button"
                        data-filter-tag={tag}
                        aria-pressed="false"
                        class="text-xs font-medium rounded-full px-3 py-2 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 transition-colors cursor-pointer"
                      >
                        {tag}
                      </button>
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>

    <p data-empty-state class="text-muted text-lg hidden">{activitiesListSettings.emptyStateText}</p>

    {
      allActivities.length === 0 ? (
        <p class="text-muted text-lg">{activitiesListSettings.emptyStateText}</p>
      ) : (
        <ul id="activity-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0" role="list">
          {allActivities.map((activity) => (
            <li data-scroll-reveal="up">
              <ActivityCard data={activity.data} href={`/activities/${activity.id}`} cardStyle={cardStyle} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>

<script>
  import { initActivityFiltersPage } from '~/utils/activityFilters';

  initActivityFiltersPage();
</script>
