---
import HeroText from '~/components/widgets/HeroText.astro';
import MailchimpForm from '~/components/widgets/MailchimpForm.astro';
import Layout from '~/layouts/PageLayout.astro';
import pageSettings from '~/data/settings/join-email-list.json';

const metadata = {
  title: pageSettings.heroTitle,
  description: pageSettings.introText,
  openGraph: { images: [{ url: '/og/default.jpg', width: 1200, height: 630 }] },
};
---

<Layout metadata={metadata}>
  <HeroText tagline={pageSettings.heroTagline} title={pageSettings.heroTitle} />

  <section class="py-8 px-4 max-w-3xl mx-auto">
    <p class="text-center text-muted mb-2">{pageSettings.introText}</p>
    <p class="text-center text-muted text-sm mb-8">
      {pageSettings.formNote}{' '}
      <a href={`mailto:${pageSettings.formNoteEmail}`} class="text-link underline">
        {pageSettings.formNoteEmail}
      </a>
      .
    </p>

    <MailchimpForm id="join-email-list-form" />
  </section>
</Layout>
