---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PersonCard from '~/components/ui/PersonCard.astro';
import rawPeopleData from '~/data/pages/people.json';
import siteSettings from '~/data/settings/site.json';
import { renderInlineMarkdown, stripMarkdown } from '~/utils/markdown';
import { balanceByWeight } from '~/utils/balanceGrid';

interface PeoplePerson {
  name: string;
  title?: string | null;
  // References a `leader` record (by its slug/id) to reuse that person's
  // photo/bio instead of duplicating them here — this person's own `photo`/
  // `bio` still win if set, so a section can deliberately use a different
  // photo (e.g. a group shot) without losing the reference for bio reuse.
  leaderId?: string | null;
  photo?: string | null;
  bio?: string | null;
}
interface PeopleCategory {
  label: string;
  people: PeoplePerson[];
}
interface PeoplePageData {
  title: string;
  categories: PeopleCategory[];
}

const peoplePageData = rawPeopleData as PeoplePageData;

// The default state of the "name-only" filter (people with neither a photo
// nor a bio) — everyone still renders regardless, this only decides whether
// they start out visible or hidden before the reader touches the toolbar.
const includeNameOnlyByDefault = siteSettings.featureFlags.peopleWithoutPhotoOrBio;
const hasProfile = (p: { photo?: string | null; bio?: string | null }) => Boolean(p.photo || p.bio);
const hiddenByDefault = (p: { photo?: string | null; bio?: string | null }) =>
  !includeNameOnlyByDefault && !hasProfile(p);

let leaders = await getCollection('leader');
leaders.sort((a, b) => a.data.name.localeCompare(b.data.name, undefined, { sensitivity: 'base' }));
const leaderById = new Map(leaders.map((l) => [l.id, l]));

// Resolve each category person's `leaderId` reference into an actual photo/bio
// once, up front, so every consumer below (cards, row-balancing, JSON-LD) sees
// the same reused-vs-duplicated data instead of resolving it independently.
peoplePageData.categories = (peoplePageData.categories ?? []).map((cat) => ({
  ...cat,
  people: (cat.people ?? []).map((p) => {
    const linked = p.leaderId ? leaderById.get(p.leaderId) : undefined;
    return {
      ...p,
      photo: p.photo ?? linked?.data.photo ?? null,
      bio: p.bio ?? linked?.data.bio ?? null,
    };
  }),
}));

// Second pass: someone who sits on multiple committees/rosters but has no
// `leader` record (so the leaderId reference above can't help) still shouldn't
// need their photo/bio re-entered on every listing — reuse whichever occurrence
// already has one, matched by exact name. This only looks within these
// editor-defined sections; it never reads from or adds anyone to the
// auto-rendered Leaders section.
const sharedProfileByName = new Map<string, { photo: string | null; bio: string | null }>();
for (const cat of peoplePageData.categories) {
  for (const p of cat.people) {
    const known = sharedProfileByName.get(p.name);
    if (!known?.photo && !known?.bio && (p.photo || p.bio)) {
      sharedProfileByName.set(p.name, { photo: p.photo ?? null, bio: p.bio ?? null });
    }
  }
}
peoplePageData.categories = peoplePageData.categories.map((cat) => ({
  ...cat,
  people: cat.people.map((p) => {
    const shared = sharedProfileByName.get(p.name);
    return {
      ...p,
      photo: p.photo ?? shared?.photo ?? null,
      bio: p.bio ?? shared?.bio ?? null,
    };
  }),
}));

// Same bio-length row-balancing as the Leaders grid below, applied per category.
// This is the "Balanced" sort option's order — alphabetical is the sort tiebreak,
// weight-descending is the primary key.
peoplePageData.categories = peoplePageData.categories.map((cat) => ({
  ...cat,
  people: balanceByWeight(
    [...cat.people].sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' })),
    (p) => (p.bio ? stripMarkdown(p.bio).length : 0)
  ),
}));

// Leaders with a mutual `partnerId` (e.g. a couple who only ever co-teach and
// share one bio/photo) are combined into a single card instead of rendering
// as two duplicate ones. The partner's own id is kept as a hidden in-page
// anchor so existing deep links (event popovers, activity pill lists) that
// point at `#leader-{their-id}` still land on the combined card.
interface DisplayLeader {
  id: string;
  extraIds: string[];
  name: string;
  title?: string;
  photo?: string;
  bio?: string;
}
const consumedLeaderIds = new Set<string>();
const displayLeaders: DisplayLeader[] = [];
for (const leader of leaders) {
  if (consumedLeaderIds.has(leader.id)) continue;
  const partner = leader.data.partnerId ? leaderById.get(leader.data.partnerId) : undefined;
  const isMutualPartner = partner && partner.data.partnerId === leader.id && !consumedLeaderIds.has(partner.id);
  consumedLeaderIds.add(leader.id);
  if (isMutualPartner) {
    consumedLeaderIds.add(partner.id);
    displayLeaders.push({
      id: leader.id,
      extraIds: [partner.id],
      name: `${leader.data.name} and ${partner.data.name}`,
      title: leader.data.title ?? partner.data.title,
      photo: leader.data.photo ?? partner.data.photo,
      bio: leader.data.bio ?? partner.data.bio,
    });
  } else {
    displayLeaders.push({
      id: leader.id,
      extraIds: [],
      name: leader.data.name,
      title: leader.data.title,
      photo: leader.data.photo,
      bio: leader.data.bio,
    });
  }
}
// Reorder (post name-sort, for a stable tiebreak) so long bios land next to long
// bios in the two-column grid, rather than stretching short cards to match tall ones.
const balancedLeaders = balanceByWeight(displayLeaders, (l) => (l.bio ? stripMarkdown(l.bio).length : 0));

// Quick-jump nav entries — one per section that will actually render below,
// in the same order as the sections themselves.
const jumpSections = [
  ...(balancedLeaders.length > 0 ? [{ id: 'leaders-heading', label: 'Leaders' }] : []),
  ...peoplePageData.categories
    .filter((cat) => cat.people && cat.people.length > 0)
    .map((cat) => ({
      id: `section-${cat.label.toLowerCase().replace(/\s+/g, '-')}`,
      label: cat.label,
    })),
];

const metadata = {
  title: peoplePageData.title,
};

const ecrsOrg = {
  '@type': 'Organization',
  name: 'Eastern Cooperative Recreation School',
  url: Astro.site ? String(Astro.site) : 'https://ecrs.org',
};

const leaderPersons = leaders.map((l) => ({
  '@type': 'Person',
  '@id': Astro.site
    ? new URL(`/our-people#leader-${l.id}`, Astro.site).href
    : `https://ecrs.org/our-people#leader-${l.id}`,
  name: l.data.name,
  ...(l.data.title ? { jobTitle: l.data.title } : {}),
  ...(l.data.bio ? { description: stripMarkdown(l.data.bio) } : {}),
  url: Astro.site
    ? new URL(`/our-people#leader-${l.id}`, Astro.site).href
    : `https://ecrs.org/our-people#leader-${l.id}`,
  worksFor: ecrsOrg,
}));

const categoryPersons = (peoplePageData.categories ?? []).flatMap((cat) =>
  (cat.people ?? []).map((p) => ({
    '@type': 'Person',
    name: p.name,
    ...(p.title ? { jobTitle: p.title } : {}),
    ...(p.bio ? { description: stripMarkdown(p.bio) } : {}),
    worksFor: ecrsOrg,
  }))
);

const peopleJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...leaderPersons, ...categoryPersons],
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(peopleJsonLd)} />
  </Fragment>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-heading mb-8">
      {peoplePageData.title}
    </h1>

    <!-- ── Quick jump nav ── -->
    {
      jumpSections.length > 1 && (
        <nav aria-label="Jump to section" class="mb-8">
          <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
            {jumpSections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="inline-block text-sm font-semibold rounded-full px-4 py-2 border border-gray-200 dark:border-gray-700 text-default hover:border-primary/40 hover:text-primary transition-colors"
                >
                  {section.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <!-- ── Sort + filter toolbar ── -->
    <div
      id="people-toolbar"
      class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50/95 dark:bg-gray-900/95 p-5 md:p-6 mb-12"
    >
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
        <div class="flex items-center gap-2 sm:gap-5">
          <span class="text-xs font-bold uppercase tracking-widest text-muted shrink-0">Sort</span>
          <div class="flex flex-wrap gap-2" role="group" aria-label="Sort order">
            <button
              type="button"
              data-people-sort="balanced"
              aria-pressed="true"
              class="text-sm font-semibold rounded-full px-4 py-2 border transition-colors cursor-pointer bg-primary text-white border-primary"
            >
              Balanced
            </button>
            <button
              type="button"
              data-people-sort="az"
              aria-pressed="false"
              class="text-sm font-semibold rounded-full px-4 py-2 border transition-colors cursor-pointer border-gray-200 dark:border-gray-700 text-default hover:border-primary/40"
            >
              A–Z
            </button>
            <button
              type="button"
              data-people-sort="za"
              aria-pressed="false"
              class="text-sm font-semibold rounded-full px-4 py-2 border transition-colors cursor-pointer border-gray-200 dark:border-gray-700 text-default hover:border-primary/40"
            >
              Z–A
            </button>
          </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-5 sm:border-l sm:border-gray-200 dark:sm:border-gray-700 sm:pl-6">
          <button
            type="button"
            id="people-filter-name-only"
            aria-pressed={includeNameOnlyByDefault}
            aria-describedby="people-filter-name-only-help"
            title="Off: only people with a photo or bio. On: everyone, including name-only listings."
            class:list={[
              'inline-flex items-center gap-1.5 text-xs font-medium rounded-full px-3 py-2 border transition-colors cursor-pointer',
              includeNameOnlyByDefault
                ? 'bg-primary text-white border-primary'
                : 'border-gray-200 dark:border-gray-700 text-default hover:border-primary/40',
            ]}
          >
            <Icon name="tabler:user" class="w-3.5 h-3.5" aria-hidden="true" />
            Empty Profiles
          </button>
          <span id="people-filter-name-only-help" class="sr-only">
            Off shows only people with a photo or bio. On also shows people listed by name only.
          </span>
        </div>
      </div>
    </div>

    <p data-people-empty class="hidden text-muted text-lg mb-12">No one to show with the current filter.</p>

    <!-- ── Program Leaders (auto from leader records) ── -->
    {
      balancedLeaders.length > 0 && (
        <section
          class:list={['mb-16', balancedLeaders.every(hiddenByDefault) && 'hidden']}
          aria-labelledby="leaders-heading"
          data-people-section
        >
          <h2
            id="leaders-heading"
            class="font-heading text-2xl font-bold text-heading mb-8 pb-2 border-b border-gray-200 dark:border-gray-700 scroll-mt-24"
          >
            Leaders
          </h2>
          <ul class="grid sm:grid-cols-2 gap-8 list-none p-0 m-0" data-people-list>
            {balancedLeaders.map((leader) => (
              <li
                id={`leader-${leader.id}`}
                class:list={['scroll-mt-24', hiddenByDefault(leader) && 'hidden']}
                data-scroll-reveal="up"
                data-person-card
                data-name={leader.name}
                data-has-profile={String(hasProfile(leader))}
              >
                {leader.extraIds.map((extraId) => (
                  <span id={`leader-${extraId}`} class="sr-only scroll-mt-24" aria-hidden="true" />
                ))}
                <PersonCard
                  name={leader.name}
                  title={leader.title}
                  photo={leader.photo}
                  bio={leader.bio ? renderInlineMarkdown(leader.bio) : undefined}
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- ── Editor-defined sections (Board of Directors, committees) ──
         These are official rosters, not a directory of profiles — everyone
         on them stays visible regardless of the "Empty Profiles" filter,
         so a name-only board or committee member never appears to be
         missing from the page. -->
    {
      (peoplePageData.categories ?? []).map((cat) =>
        cat.people && cat.people.length > 0 ? (
          <section
            class="mb-16"
            aria-labelledby={`section-${cat.label.toLowerCase().replace(/\s+/g, '-')}`}
            data-people-section
          >
            <h2
              id={`section-${cat.label.toLowerCase().replace(/\s+/g, '-')}`}
              class="font-heading text-2xl font-bold text-heading mb-8 pb-2 border-b border-gray-200 dark:border-gray-700 scroll-mt-24"
            >
              {cat.label}
            </h2>
            <ul class="grid sm:grid-cols-2 gap-8 list-none p-0 m-0" data-people-list>
              {cat.people.map((person) => (
                <li data-scroll-reveal="up" data-person-card data-name={person.name} data-has-profile="true">
                  <PersonCard
                    name={person.name}
                    title={person.title ?? undefined}
                    photo={person.photo ?? undefined}
                    bio={person.bio ? renderInlineMarkdown(person.bio) : undefined}
                  />
                </li>
              ))}
            </ul>
          </section>
        ) : null
      )
    }

    <button
      type="button"
      data-back-to-top
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-40 rounded-full bg-primary text-white shadow-lg p-3 opacity-0 pointer-events-none cursor-pointer transition-opacity duration-200 hover:bg-primary/90"
    >
      <Icon name="tabler:arrow-up" class="w-5 h-5" aria-hidden="true" />
    </button>
  </div>
</Layout>

<script>
  import { initPeopleFiltersPage } from '~/utils/peopleFilters';
  import { initBackToTopPage } from '~/utils/backToTop';

  initPeopleFiltersPage();
  initBackToTopPage();
</script>
